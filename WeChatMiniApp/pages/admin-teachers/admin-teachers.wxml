<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索姓名/昵称/学科" value="{{keyword}}" confirm-type="search" bindinput="onKeyword"/>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{showEmpty}}" class="tip">暂无教师数据</view>

  <view wx:else class="list">
    <view class="row" wx:for="{{list}}" wx:key="teacherId" data-id="{{item.teacherId}}" bindtap="openDetail">
      <view class="row-main">
        <view class="row-name">{{item.teacherName}}</view>
        <view class="row-sub" wx:if="{{item.showNick}}">昵称：{{item.nickName}}</view>
        <view class="row-sub">任教科目：{{item.subjectText}}</view>
        <view class="row-sub">带课 {{item.lessonCount}} 节　基本工资：{{item.baseSalary != null ? item.baseSalary : '未设置'}}</view>
      </view>
      <view class="row-tags">
        <text class="badge {{item.hasConfig ? 'ok' : 'warn'}}">{{item.hasConfig ? '已设标准' : '未设标准'}}</text>
        <text class="edit-link" catchtap="openEdit" data-id="{{item.teacherId}}">编辑标准</text>
      </view>
    </view>
  </view>

  <!-- 详情弹层 -->
  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{detail.teacherName}}</text>
        <text class="sheet-close" bindtap="closeDetail">关闭</text>
      </view>
      <view class="info"><text class="info-k">姓名</text><text class="info-v">{{detail.teacherName}}</text></view>
      <view class="info" wx:if="{{detail.showNick}}"><text class="info-k">昵称</text><text class="info-v">{{detail.nickName}}</text></view>
      <view class="info"><text class="info-k">登录账号</text><text class="info-v">{{detail.userName || (detailLoading ? '加载中…' : '—')}}</text></view>
      <view class="info"><text class="info-k">手机号</text><text class="info-v">{{detail.phonenumber || (detailLoading ? '加载中…' : '—')}}</text></view>
      <view class="info"><text class="info-k">角色</text><text class="info-v">{{detail.roles || (detailLoading ? '加载中…' : '—')}}</text></view>
      <view class="info"><text class="info-k">账号状态</text><text class="info-v">{{detail.status || (detailLoading ? '加载中…' : '—')}}</text></view>
      <view class="info"><text class="info-k">任教科目</text><text class="info-v">{{detail.subjectText}}</text></view>
      <view class="info"><text class="info-k">带课节数</text><text class="info-v">{{detail.lessonCount}} 节</text></view>
      <view class="info"><text class="info-k">基本工资</text><text class="info-v">{{detail.baseSalary != null ? detail.baseSalary : '未设置'}}</text></view>
      <button class="btn-primary" data-id="{{detail.teacherId}}" bindtap="openEdit">编辑薪资标准</button>
    </view>
  </view>

  <!-- 薪资标准编辑弹层 -->
  <view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">薪资标准 · {{editForm.teacherName}}</text>
        <text class="sheet-close" bindtap="closeEdit">取消</text>
      </view>
      <view class="form-item"><text class="form-label">基本工资</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="baseSalary" value="{{editForm.baseSalary}}" placeholder="元/月"/></view>
      <view class="form-item"><text class="form-label">小学班课(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="ratePrimaryClass" value="{{editForm.ratePrimaryClass}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">初高中班课(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="rateJhClass" value="{{editForm.rateJhClass}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">特价课(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="rateSpecialClass" value="{{editForm.rateSpecialClass}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">小学一对一(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="ratePrimary1on1" value="{{editForm.ratePrimary1on1}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">初中一对一(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="rateJunior1on1" value="{{editForm.rateJunior1on1}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">高中一对一(元/h)</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="rateSenior1on1" value="{{editForm.rateSenior1on1}}" placeholder="0"/></view>
      <view class="form-item"><text class="form-label">每节课时数</text><input class="form-input" type="digit" bindinput="onEditInput" data-field="classHoursPerSession" value="{{editForm.classHoursPerSession}}" placeholder="如 1.5、2"/></view>
      <view class="form-item"><text class="form-label">备注</text><input class="form-input" bindinput="onEditInput" data-field="remark" value="{{editForm.remark}}" placeholder="选填"/></view>
      <button class="btn-primary" bindtap="saveEdit">保存薪资标准</button>
      <view class="section-title" style="margin-top:32rpx;font-weight:bold">班课人次提成（人次）</view>
      <picker mode="date" fields="month" value="{{attendanceMonth}}" bindchange="attendanceMonthChange" disabled="{{attendanceSaving}}"><view class="info">统计月份：{{attendanceMonth}} ▾</view></picker>
      <view wx:if="{{attendanceLoading}}" class="info">人次加载中…</view>
      <view wx:elif="{{attendanceError}}" class="info" bindtap="loadAttendance">{{attendanceError}}，点击重试</view>
      <block wx:elif="{{attendanceInfo}}">
        <view class="info">自动统计：{{attendanceInfo.automaticCount}} 人次 · {{attendanceInfo.manual ? '已手动调整' : '自动生成'}}</view>
        <view class="form-item"><text class="form-label">班课人次</text><input class="form-input" type="number" value="{{attendanceInput}}" bindinput="attendanceInputChange" disabled="{{!canAdjustAttendance || attendanceSaving}}"/></view>
        <view class="row-sub">按终审通过的班课到课人数累计，含试听和调课；一对一不计。仅记录人次，不参与工资金额计算。</view>
        <view wx:if="{{canAdjustAttendance}}"><button size="mini" bindtap="saveAttendance" loading="{{attendanceSaving}}" disabled="{{attendanceSaving}}">保存人次</button><button size="mini" bindtap="resetAttendance" disabled="{{attendanceSaving || !attendanceInfo.manual}}">恢复自动统计</button></view>
      </block>
    </view>
  </view>
</view>
