page{min-height:100vh;background:#f4f7fb}
.page{padding:20rpx}
.toolbar{display:flex;align-items:center;gap:14rpx;padding:14rpx;background:#fff;border-radius:16rpx}
.tool{padding:12rpx 22rpx;border-radius:12rpx;background:#eef2f7;color:#172033;font-size:26rpx}
.tool.on{background:#1768c2;color:#fff}
.colors{display:flex;gap:12rpx;margin:0 8rpx}
.dot{width:44rpx;height:44rpx;border-radius:50%;border:3rpx solid transparent}
.dot.on{border-color:#172033}
.hint{margin:14rpx 0;padding:12rpx 20rpx;background:#fff7e6;color:#b06d0f;border-radius:12rpx;font-size:24rpx;text-align:center}
.canvas-wrap{display:flex;justify-content:center;margin-top:16rpx}
.cv{background:#fff;border-radius:12rpx}
.save{margin-top:24rpx;background:#1b9a68;color:#fff}
