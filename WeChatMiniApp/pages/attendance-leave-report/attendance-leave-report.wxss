page {background:#f4f6fa}.page {padding:32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));color:#263b57}.header {padding:8rpx 8rpx 28rpx}.title {font-size:40rpx;font-weight:700}.subtitle {margin-top:12rpx;color:#8492a6;font-size:25rpx}.filters,.card {background:#fff;border:1rpx solid #e6ecf5;border-radius:22rpx;padding:24rpx}.search-row {display:flex;gap:14rpx}.search-row input {flex:1;width:0;background:#f4f6fa;border-radius:12rpx;padding:0 18rpx;font-size:25rpx;height:80rpx}.search-row button {flex:0 0 112rpx;width:112rpx;margin:0;padding:0;height:80rpx;line-height:80rpx;background:#2b5ac7;color:#fff;font-size:27rpx}.filter-grid {display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:16rpx}.filter-grid picker,.state-picker {padding:18rpx;background:#f3f6fa;border-radius:12rpx;font-size:25rpx;overflow:hidden}.state-picker {margin-top:12rpx}.dates {display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:20rpx;color:#8190a6;font-size:23rpx}.dates picker {padding:12rpx;background:#f5f7fb;border-radius:8rpx}.reset,.detail {color:#315fab}.note {margin:20rpx 6rpx;font-size:23rpx;color:#8190a6;line-height:1.7}.metrics {display:flex;background:#fff;border-radius:18rpx;padding:24rpx 4rpx;margin:20rpx 0}.metrics>view {flex:1;text-align:center;font-size:21rpx;color:#8292aa}.metrics text {display:block;font-size:36rpx;font-weight:700;color:#294d80;margin-bottom:10rpx}.metrics .pending text,.pending-label {color:#b67b25}.list-heading {display:flex;align-items:center;justify-content:space-between;margin:22rpx 4rpx;font-size:27rpx;font-weight:600}.card {margin-bottom:20rpx}.student {display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600}.pending-label {background:#fff6e7;border-radius:8rpx;padding:6rpx 12rpx;font-size:22rpx;font-weight:400}.course {font-size:28rpx;font-weight:600;line-height:1.6;margin-top:18rpx}.meta {color:#8593a8;font-size:23rpx;line-height:1.7;margin-top:8rpx}.card-footer {border-top:1rpx solid #