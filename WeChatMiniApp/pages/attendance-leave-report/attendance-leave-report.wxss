.state.scheduled{color:#315fab}.state.failed{color:#ba6c35}.lesson-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.lesson-actions button{margin:0;padding:0 18rpx;height:58rpx;line-height:58rpx;font-size:23rpx;color:#315fab;background:#edf3ff;border-radius:10rpx}.lesson-actions .cancel-link{color:#a57027;background:#fff6e7}.lesson-actions .history-link{color:#8190a6;background:#f4f6fa}.sheet-mask{position:fixed;inset:0;z-index:100;background:rgba(25,42,65,.42);display:flex;align-items:flex-end}.makeup-sheet{width:100%;max-height:92vh;background:#fff;border-radius:28rpx 28rpx 0 0;padding-bottom:env(safe-area-inset-bottom);color:#263b57}.sheet-heading{display:flex;align-items:center;justify-content:space-between;padding:28rpx;font-size:32rpx;font-weight:600;border-bottom:1rpx solid #edf0f6}.sheet-heading button{margin:0;padding:0 14rpx;height:56rpx;line-height:56rpx;font-size:24rpx;background:#f3f6fa;color:#315fab}.sheet-content{height:65vh;box-sizing:border-box;padding:0 28rpx 28rpx}.sheet-source{margin:24rpx 0;padding:20rpx;background:#edf3ff;color:#315fab;border-radius:12rpx;font-size:25rpx;line-height:1.7}.field-label{font-size:25rpx;font-weight:600;margin:24rpx 0 14rpx}.choice{margin-top:14rpx;padding:22rpx;background:#f3f6fa;border:1rpx solid #e6ecf5;border-radius:12rpx;font-size:25rpx;line-height:1.6}.makeup-sheet textarea{box-sizing:border-box;width:100%;height:150rpx;padding:18rpx;background:#f3f6fa;border-radius:12rpx;font-size:25rpx}.history-title{margin-top:30rpx;font-size:26rpx;font-weight:600}.history-entry{padding:20rpx 0;border-bottom:1rpx solid #edf0f6;font-size:24rpx;line-height:1.7}.cancelled{color:#a57027}.sheet-footer{padding:20rpx 28rpx;border-top:1rpx solid #edf0f6}.submit-makeup{background:#2b5ac7;color:#fff;border-radius:12rpx;font-size:28rpx}.submit-makeup[disabled]{background:#e3eaf6;color:#8593a8}

.refresh-makeup{margin-top:18rpx;color:#315fab;background:#edf3ff;font-size:26rpx}

