page{background:#f4f7fb;color:#24344b}.page{padding:24rpx}.card{padding:24rpx;background:#fff;border-radius:18rpx;margin-bottom:20rpx;line-height:1.7}.heading{font-size:36rpx;font-weight:700}.title{font-size:30rpx;font-weight:700;word-break:break-all}.muted{font-size:24rpx;color:#748399;line-height:1.7}.search,.actions,.pager,.footer{display:flex;align-items:center;gap:16rpx}.search{margin:20rpx 0}.search input{flex:1;min-width:0}.search button,.actions button{margin:0;flex-shrink:0}.actions{justify-content:flex-end;margin-top:16rpx}.primary{background:#2459d9;color:#fff}.pager{justify-content:space-between;font-size:24rpx}.pager button{margin:0}.empty{text-align:center;padding:30rpx}.error{color:#b04436;font-size:25rpx;line-height:1.6;padding:16rpx 0;word-break:break-all}.shade{position:fixed;top:0;left:0;right:0;bottom:0;background:#0006;z-index:50;display:flex;align-items:flex-end}.sheet{width:100%;height:88vh;background:#fff;border-radius:24rpx 24rpx 0 0;padding:24rpx 0 0;display:flex;flex-direction:column;box-sizing:border-box}.sheet>.title{padding:0 24rpx 16rpx}.body{flex:1;height:0;min-height:0}.form{padding:0 24rpx 24rpx}.label{font-size:26rpx;font-weight:600;margin:24rpx 0 12rpx}input,.field,textarea{width:100%;box-sizing:border-box;background:#f4f7fb;border:1rpx solid #dce5f2;border-radius:12rpx;font-size:28rpx}input{height:82rpx;padding:0 18rpx;line-height:normal}.field{min-height:82rpx;line-height:1.5;padding:18rpx;word-break:break-all}textarea{height:150rpx;padding:18rpx;line-height:1.5}.footer{padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #edf0f4;flex-shrink:0}.footer button{flex:1;margin:0;font-size:28rpx;padding:0 12rpx}
