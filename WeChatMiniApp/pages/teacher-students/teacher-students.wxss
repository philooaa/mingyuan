@import "../../styles/education-ui.wxss";
.page { padding: 28rpx; background: #f4f7fb; min-height: 100vh; box-sizing: border-box; color: #25354a; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.muted { color: #738196; font-size: 25rpx; line-height: 1.8; }
.search { display: flex; align-items: center; gap: 12rpx; margin: 24rpx 0; }
.search input { flex: 1; min-width: 0; background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; }
.search button { flex-shrink: 0; margin: 0; }
.back { color: #356acc; padding: 12rpx 0; }
.card { background: #fff; border-radius: 18rpx; padding: 26rpx; margin: 20rpx 0; font-size: 27rpx; line-height: 1.8; }
.empty { padding: 32rpx 0; text-align: center; color: #738196; }
.history { border-top: 1rpx solid #eef1f6; margin-top: 18rpx; padding-top: 18rpx; }

/* 教育业务页面：紧凑布局与信息层级 */

.page { padding:26rpx 24rpx; }
.page > .title { font-size:38rpx; color:#202b3d; font-weight:700; margin-bottom:6rpx; }
.title { font-size:30rpx; font-weight:700; line-height:1.5; }
.muted { font-size:24rpx; line-height:1.7; color:#68778c; }
.card { border:1rpx solid #e8edf4; border-radius:16rpx; padding:24rpx; box-shadow:none; margin:16rpx 0; line-height:1.7; font-size:26rpx; }
.search { gap:12rpx; margin:20rpx 0 12rpx; }
.search input { height:80rpx; border:1rpx solid #e8edf4; padding:0 18rpx; font-size:26rpx; border-radius:12rpx; line-height:normal; }
.search button { color:white; background:#2459d9; border-radius:10rpx; line-height:76rpx; font-size:25rpx; padding:0 22rpx; }
.back { font-size:25rpx; margin:8rpx 0; color:#2459d9; }
.history { padding-top:16rpx; margin-top:16rpx; font-size:25rpx; }
