@import "../timetable/timetable.wxss";
@import "../../styles/teacher-week-calendar.wxss";
.create-heading { padding:24rpx; }.availability-note { margin:0 24rpx 16rpx; color:#68778c; font-size:23rpx; line-height:1.6; }
.publish-slot { position:absolute; left:7rpx; right:7rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; box-sizing:border-box; border:1rpx dashed #dfe3e9; border-radius:10rpx; background:#fafbfc; color:#a8afb9; }
.publish-plus { font-size:48rpx; font-weight:300; line-height:1.3; }.publish-count { font-size:20rpx; color:#929ca9; }.lesson-block { z-index:1; }
.create-mask { position:fixed; inset:0; background:rgba(20,30,45,.35); z-index:20; }.create-sheet { position:fixed; bottom:0; left:0; right:0; padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:white; z-index:21; }
.sheet-title { font-size:34rpx; font-weight:700; }.selected-time { margin:20rpx 0 8rpx; font-size:29rpx; color:#2459d9; font-weight:600; }.create-field { padding:22rpx 0; border-bottom:1rpx solid #edf0f4; font-size:27rpx; }.create-field>text { display:block; margin-bottom:14rpx; color:#68778c; font-size:24rpx; }.create-actions { display:flex; gap:20rpx; margin-top:28rpx; }.create-actions button { flex:1; font-size:28rpx; }
