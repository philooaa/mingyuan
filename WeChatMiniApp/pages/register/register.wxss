page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.auth-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #eaf3ff 0%, #f4f7fb 50%, #f4f7fb 100%);
}

.brand { padding: 32rpx 16rpx 42rpx; }
.logo { display: block; width: 420rpx; max-width: 100%; }
.title { margin-top: 38rpx; color: #10376c; font-size: 44rpx; line-height: 1.4; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 12rpx; color: #73839a; font-size: 25rpx; line-height: 1.6; }

.panel {
  padding: 40rpx 32rpx 32rpx;
  border: 1rpx solid #fff;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 16rpx 50rpx rgba(27, 66, 115, 0.07);
}
.panel-title { color: #18385f; font-size: 34rpx; font-weight: 700; }
.panel-subtitle { margin-top: 10rpx; margin-bottom: 34rpx; color: #8995a7; font-size: 24rpx; line-height: 1.6; }
.field-label { margin: 26rpx 0 14rpx; color: #4b5d75; font-size: 25rpx; font-weight: 500; }
.phone-field, .code-input { border: 1rpx solid #e5ebf3; border-radius: 18rpx; background: #f6f8fc; }
.phone-field, .code-row { display: flex; align-items: center; box-sizing: border-box; }
.phone-prefix { flex: 0 0 auto; padding: 0 24rpx; border-right: 1rpx solid #dae3ef; color: #344f70; font-size: 28rpx; }
.account-input { flex: 1; min-width: 0; width: 0; height: 96rpx; box-sizing: border-box; padding: 0 22rpx; color: #18385f; font-size: 28rpx; }
.input-placeholder { color: #a2adbd; }
.code-row { gap: 16rpx; }

.code-button {
  flex: 0 0 208rpx;
  width: 208rpx;
  height: 96rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #eaf2ff;
  color: #165ba7;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 96rpx;
  white-space: nowrap;
}
.code-button::after, .wechat-btn::after { border: none; }

.development-hint {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 26rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff8e9;
  color: #987432;
  font-size: 22rpx;
  line-height: 1.6;
}
.development-label { font-weight: 600; }
.test-code { margin-top: 12rpx; padding: 18rpx; border-radius: 14rpx; background: #fff3d8; color: #875100; font-size: 27rpx; letter-spacing: 2rpx; }
.teacher-hint, .teacher-error { margin-top: 20rpx; font-size: 24rpx; line-height: 1.6; color: #75849a; }
.teacher-error { color: #b13b32; }

.panel .wechat-btn {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin: 32rpx 0 0;
  padding: 0;
  border-radius: 18rpx;
  background: linear-gradient(110deg, #1767ba, #104f99);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-shadow: 0 10rpx 22rpx rgba(15, 88, 168, 0.18);
}
.register-note { margin-top: 24rpx; text-align: center; color: #94a0b1; font-size: 23rpx; line-height: 1.6; }
.auth-footer { margin: 36rpx 12rpx 0; text-align: center; color: #98a5b7; font-size: 22rpx; line-height: 1.9; }
