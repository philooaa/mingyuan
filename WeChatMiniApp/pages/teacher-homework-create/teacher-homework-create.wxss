page{min-height:100vh;background:#f4f7fb;color:#172033}.page{padding:24rpx}.header{padding:24rpx;font-size:38rpx;font-weight:800}.card{margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:20rpx}.card input,.card textarea{width:100%;margin-bottom:18rpx;padding:18rpx;border:1rpx solid #dce5f2;border-radius:12rpx;box-sizing:border-box}.card input{height:80rpx;padding:0 18rpx;line-height:normal}.card textarea{min-height:120rpx}.hint{margin-bottom:18rpx;color:#8993a4;font-size:24rpx}.picker{margin-bottom:18rpx;padding:18rpx;border:1rpx solid #dce5f2;border-radius:12rpx;color:#66748a}.section{margin-bottom:16rpx;font-weight:700}.btn-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:8rpx}.file{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx;font-size:25rpx;color:#526175}.file text:last-child{color:#d94c4c;margin-left:20rpx}.question{padding:18rpx 0;border-top:1rpx solid #edf1f6}.question-head{display:flex;justify-content:space-between;margin-bottom:14rpx;font-weight:700}.remove{color:#d94c4c;font-weight:400}.submit{margin-top:30rpx;background:#1768c2;color:#fff}