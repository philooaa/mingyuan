<view class="page"><view class="header">{{headerText}}</view><view class="card"><view class="hint">发布对象将在发布时选择</view><input placeholder="作业标题" value="{{form.title}}" data-field="title" bindinput="input"/><textarea placeholder="作业说明" value="{{form.description}}" auto-height data-field="description" bindinput="input"/><picker mode="date" value="{{deadlineDate}}" bindchange="dateChange"><view class="picker">截止日期：{{deadlineDate || '请选择'}}</view></picker><picker mode="time" value="{{deadlineTime}}" bindchange="timeChange"><view class="picker">截止时间：{{deadlineTime || '请选择（精确到分钟）'}}</view></picker></view><view class="card"><view class="section">教师附件</view><view class="btn-row"><button size="mini" bindtap="chooseFile">上传附件（图片/PDF/文档/音频/视频）</button></view><view wx:for="{{files}}" wx:key="filePath" class="file"><text>📄　{{item.fileName || item.filePath}}</text><text data-index="{{index}}" bindtap="removeFile">删除</text></view></view><button class="submit" loading="{{saving}}" bindtap="save">{{submitText}}</button></view>
