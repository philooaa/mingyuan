<view class="page"><view class="hero"><view class="brand"><image class="logo" src="/images/logo.png" mode="aspectFit"/><view class="heading">收费财务</view></view><view class="muted">教务核价并登记线下收款，管理员核对确认。退费可进入下方退费管理，由教务确认金额、管理员登记已退款；历史记录由管理员核对。</view></view><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新</button></view>
  <button class="small" wx:if="{{allowed.refundList}}" bindtap="refunds" disabled="{{submitting}}">进入退费管理</button>
  <block wx:if="{{!detail}}"><input value="{{searchText}}" data-field="searchText" bindinput="input" bindconfirm="search" placeholder="按学生姓名查询"/><view class="row"><picker wx:if="{{!confirmationOnly}}" class="grow" range="{{filters}}" value="{{filterIndex}}" bindchange="filter"><view class="picker">{{filters[filterIndex]}} ▾</view></picker><button class="primary small" bindtap="search" disabled="{{loading}}">查询</button></view><view class="card" wx:for="{{rows}}" wx:key="enrollmentId" data-id="{{item.enrollmentId}}" bindtap="detail"><view class="row"><view class="title">{{item.courseClassName}}</view><view class="tag">{{item.progressText}}</view></view><view class="muted">{{item.studentName}} · {{item.parentName}} · {{item.campusName}}</view><view class="muted number">{{item.enrollmentCode}}</view><view class="safe" wx:if="{{item.financeMode === 'MOCK'}}">模拟 · 不涉及真实资金</view><view class="amount-grid"><view><view class="muted">应付 / 待缴</view><view class="value">{{item.payableText}} / {{item.dueText}}</view></view><view><view class="muted">已收 / 已退</view><view class="value">{{item.receivedText}} / {{item.refundedText}}</view></view></view><button class="primary small" wx:if="{{confirmationOnly && item.requiresConfirmation && allowed.confirm}}" data-id="{{item.enrollmentId}}" catchtap="detail">待我确认 ›</button><view class="link" wx:elif="{{allowed.query}}">查看进度／详情 ›</view></view></block>
  <block wx:if="{{detail}}"><view class="card"><view class="title">{{detail.courseClassName}}</view><view class="muted">{{detail.studentName}} · {{detail.parentName}} · {{detail.campusName}}</view><view class="muted number">{{detail.enrollmentCode}}</view><view class="tag">{{detail.statusText}} · {{detail.payStatus || '待核实'}}</view><view class="safe" wx:if="{{detail.financeMode === 'MOCK'}}">模拟账单 · 不涉及真实资金</view><view class="amount-grid"><view><view class="muted">原价 / 优惠</view><view class="value">{{detail.originalText}} / {{detail.discountText}}</view></view><view><view class="muted">应付 / 待缴</view><view class="value">{{detail.payableText}} / {{detail.dueText}}</view></view><view><view class="muted">实收 / 已退</view><view class="value">{{detail.receivedText}} / {{detail.refundedText}}</view></view><view><view class="muted">净收 / 可退</view><view class="value">{{detail.netText}} / {{detail.refundableText}}</view></view></view></view>
  <view class="workflow-progress {{detail.requiresConfirmation ? 'workflow-pending' : ''}}"><view class="title">{{detail.progressText}}</view><view class="muted" wx:if="{{detail.progressStage === 'WAIT_EDU_PRICE'}}">第一步尚未完成：由教务核定费用，管理员暂无需确认。</view><view class="muted" wx:elif="{{detail.progressStage === 'WAIT_EDU_COLLECT'}}">第一步已完成：等待教务登记实际收款，管理员暂无需确认。</view><view wx:elif="{{detail.requiresConfirmation}}">前两步已完成：请管理员核对下方收款记录后确认。</view><view wx:elif="{{detail.progressStage === 'COMPLETED'}}">三个步骤均已完成，可查看收款记录与收据。</view></view>
  <view class="notice" wx:if="{{detail.billingStatus === 'HISTORY_PENDING'}}">历史账单金额待核验，请使用网页专用历史核验流程，附凭证和实际时间。不能按0元处理或普通核价。</view>
  <view class="card" wx:if="{{detail.billType === 'CREDIT_PACKAGE' && detail.packageSnapshot}}"><view class="title">一对一课包购买</view><view>{{detail.packageSnapshot.packageCount}}包 · {{detail.packageSnapshot.credits}}基础次数</view><view>课包优惠 ¥{{detail.packageSnapshot.packageDiscount}} · 优惠券 ¥{{detail.packageSnapshot.couponDiscount}}</view><view>最终应付 ¥{{detail.packageSnapshot.payableAmount}}</view><view class="muted">系统核价，不支持手工改价或换券。{{detail.packageCreditedTime ? '收款已确认，次数已入账' : '确认线下收款后，次数才进入孩子账户'}}</view></view>
  <view class="card" wx:if="{{billingStep === 1 && allowed.price}}"><view class="title">第一步：核定费用</view>
    <block wx:if="{{detail.billType === 'CART_ORDER'}}"><view class="label">课程总价（元）</view><view class="value">{{priceBaseText}}</view><view class="muted">购物车订单总价由订单内课程自动汇总，不能手工修改；教务只填写优惠金额。</view></block>
    <block wx:else><view class="label">核定原价（元）</view><input type="digit" value="{{price}}" data-field="price" bindinput="input" placeholder="核定原价（元）"/></block>
    <view class="label">优惠金额（元）</view><input type="digit" value="{{discountAmount}}" data-field="discountAmount" bindinput="input" placeholder="按实际情况直接填写优惠多少钱，可填 0"/>
    <view class="label">优惠原因</view><input value="{{discountReason}}" data-field="discountReason" bindinput="input" placeholder="优惠金额大于 0 时必填"/>
    <view class="coupon-quote"><view>原价 {{priceBaseText}} − 优惠 {{priceDiscountText}}</view><view class="value">实际应收 {{pricePayableText}}</view></view>
    <picker wx:if="{{detail.billType !== 'CART_ORDER'}}" range="{{modeLabels}}" value="{{modeIndex}}" bindchange="mode" disabled="{{submitting}}"><view class="picker">{{modeLabels[modeIndex]}} ▾</view></picker>
    <view class="muted" wx:else>{{modeLabels[modeIndex]}}（订单创建时已确定，核价时不可切换）</view>
    <button class="primary" bindtap="savePrice" loading="{{submitting}}" disabled="{{submitting || loading}}">{{detail.billingStatus === 'OPEN' ? '更新核价' : '确认核价'}}</button></view>
  <view id="collection-form" class="card" wx:if="{{billingStep === 2 && allowed.collect}}">
    <view class="title">第二步：登记实际收款</view>
    <view class="notice" wx:if="{{detail.canPay}}">账单已核价。先核对优惠券与最终应收，再填写付款人、实际收款时间及凭证。核价和试算均不会标记已缴费。</view>
    <block wx:if="{{!retryPayment}}">
      <view class="label">使用优惠券</view>
      <picker wx:if="{{detail.billType !== 'CREDIT_PACKAGE'}}" range="{{couponOptions}}" value="{{couponIndex}}" bindchange="chooseCoupon" disabled="{{submitting || loading || quoteLoading}}"><view class="picker">{{couponOptions[couponIndex]}} ▾</view></picker>
      <view class="muted" wx:if="{{detail.billType !== 'CREDIT_PACKAGE'}}">只显示该家长满足课程、金额及有效期条件的优惠券，每次最多使用一张。{{!availableCoupons.length && !quoteLoading && !quoteError ? '当前暂无适用优惠券。' : ''}}</view>
      <view class="muted" wx:else>课包优惠券在购买时已确定，收款时不能更换。</view>
      <view class="muted" wx:if="{{quoteLoading}}">正在试算优惠金额…</view>
      <view class="error" wx:if="{{quoteError}}">{{quoteError}}</view>
      <view class="coupon-quote" wx:if="{{quote}}"><view>原价 ¥{{quote.originalAmount}} − 优惠 ¥{{quote.discountAmount}}</view><view class="value">最终应收 ¥{{quote.payableAmount}}</view></view>
      <button class="small" bindtap="refreshQuote" disabled="{{submitting || loading || quoteLoading}}">刷新报价</button>
    </block>
    <view class="notice" wx:else>原登记的优惠券、金额和请求标识已锁定，重试不会重复创建新登记。</view>
    <view class="label">实际付款人</view><input value="{{payerName}}" data-field="payerName" bindinput="input" placeholder="实际付款人姓名"/>
    <view class="label">实际收款时间</view><view class="paid-time-row"><picker class="paid-date" mode="date" value="{{paidDate || pickerDate}}" bindchange="paidDateChange" disabled="{{submitting}}"><view class="picker">{{paidDate || '选择日期'}} ▾</view></picker><picker class="paid-clock" mode="multiSelector" range="{{timeRanges}}" value="{{timeIndex}}" bindchange="paidClockChange" disabled="{{submitting}}"><view class="picker">{{paidClock || '选择时分秒'}} ▾</view></picker></view>
    <button class="small" bindtap="paidTimeNow" disabled="{{submitting}}">当前时间</button>
    <view class="label">完整流水参考号</view><input value="{{providerTradeNo}}" data-field="providerTradeNo" bindinput="input" placeholder="转账渠道须可核对，现金可空"/>
    <button class="small" wx:if="{{allowed.collect}}" bindtap="chooseEvidence" disabled="{{submitting}}">选择私有PDF / 图片凭证</button><view class="muted">{{evidenceName}}</view>
    <block wx:if="{{allowed.collect && (detail.canPay || retryPayment)}}"><picker range="{{channelLabels}}" value="{{channelIndex}}" bindchange="channel" disabled="{{submitting || retryPayment || (quote && quote.payableAmount === '0.00')}}"><view class="picker">{{!retryPayment && quote && quote.payableAmount === '0.00' ? '费用减免' : channelLabels[channelIndex]}} ▾</view></picker><view class="notice">线下已实际收款才登记，随后核对确认。零元账单生成费用减免确认单。</view><button class="primary" bindtap="collect" loading="{{submitting}}" disabled="{{submitting || loading || (!retryPayment && (quoteLoading || !quote || !!quoteError))}}">登记收款 / 重试原登记</button></block>
    <button class="small" wx:if="{{allowed.price && !detail.payments.length && !retryPayment}}" bindtap="editPrice" disabled="{{submitting || quoteLoading}}">返回修改核价</button>
  </view>
<block wx:if="{{detail.payments.length}}">  <view id="payment-records" class="section-title">{{billingStep === 3 ? (allowed.confirm || allowed.close ? '第三步：核对并确认收款' : '等待管理员核对收款') : '付款记录'}}</view><view class="card" wx:for="{{detail.payments}}" wx:key="paymentId"><view class="row"><view class="title">{{item.statusText}} · {{item.channelText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.paymentNo}}</view><view class="muted">付款人 {{item.payerName}} · {{item.paidTime}}</view><view class="muted number">流水 {{item.providerTradeNo || '无'}} · {{item.evidenceKey ? '已留凭证' : '无凭证'}}</view><view class="muted" wx:if="{{item.failureReason && item.failureReason !== 'null'}}">{{item.failureReason}}</view><view class="actions" wx:if="{{item.paymentStatus === 'PENDING' || item.paymentStatus === 'UNKNOWN'}}"><button class="primary small" wx:if="{{allowed.confirm}}" data-id="{{item.paymentId}}" data-action="confirm" bindtap="paymentAction" disabled="{{submitting}}">核对并确认</button><button class="small" wx:if="{{allowed.close}}" data-id="{{item.paymentId}}" data-action="close" bindtap="paymentAction" disabled="{{submitting}}">核对后关闭</button></view></view><view class="card" wx:if="{{billingStep === 3 && allowed.close}}"><view class="label">关闭未成功付款原因</view><input value="{{closeReason}}" data-field="closeReason" bindinput="input" placeholder="必须核对没有实际收款，保留原因"/></view></block>
<view class="safe" wx:if="{{billingStep === 4}}">收款已确认，收费流程已完成。</view><block wx:if="{{detail.receipts.length}}">  <view id="receipt-records" class="section-title">收据</view><view class="card" wx:for="{{detail.receipts}}" wx:key="receiptId"><view class="row"><view>{{item.title}} · {{item.statusText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.receiptNo}} · {{item.fileText}}</view><button class="small" wx:if="{{allowed.download && item.canDownload}}" data-id="{{item.receiptId}}" bindtap="receipt">查看PDF</button></view></block>
  <view class="section-title" wx:if="{{detail.refunds.length}}">退费记录</view><view class="card" wx:for="{{detail.refunds}}" wx:key="refundId"><view class="row"><view>{{item.kindText}}</view><view>{{item.statusText}}</view></view><view class="muted" wx:if="{{item.refundStatus === 'SUCCESS'}}">实际退款 {{item.approvedText}}</view><view class="muted">{{item.progressText || item.workflowText}}</view><view class="muted">{{item.reason}} · {{item.reviewRemark}}</view><button class="small" wx:if="{{allowed.refundQuery}}" data-id="{{item.refundId}}" bindtap="refunds" disabled="{{submitting}}">查看／处理退费</button></view></block><view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:if="{{!loading && !error && !detail && !rows.length}}">{{confirmationOnly ? '暂无待确认收款' : '暂无收费账单'}}</view>
</view>
