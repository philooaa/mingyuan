page{min-height:100vh;background:#f4f7fb}.page{padding:24rpx;color:#172033}.header{padding:24rpx 24rpx 8rpx}.header-title{font-size:38rpx;font-weight:800}.header-sub{margin-top:8rpx;font-size:26rpx;color:#1768c2}.summary{display:flex;flex-wrap:wrap;gap:24rpx;margin:12rpx 0 20rpx;padding:20rpx 24rpx;background:#eaf3ff;border-radius:16rpx;color:#1768c2;font-size:24rpx}.summary .pending{color:#d97706}.summary .unreviewed{color:#c2410c}.group{margin-bottom:28rpx}.group-head{display:flex;align-items:baseline;justify-content:space-between;padding:12rpx 8rpx}.group-name{font-size:30rpx;font-weight:700}.group-stat{font-size:24rpx;color:#66748a}.group-warn{color:#d97706}.card{position:relative;margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 24rpx #14325a0f}.title{font-size:30rpx;font-weight:700}.meta{margin-top:12rpx;color:#66748a;font-size:24rpx}.score{position:absolute;right:24rpx;top:28rpx;color:#1768c2;font-size:30rpx;font-weight:700}.score.todo{color:#d97706;font-size:26rpx}.miss-block{padding:20rpx 24rpx;background:#fff7ed;border-radius:20rpx}.miss-title{font-size:26rpx;font-weight:700;color:#d97706}.miss-names{margin-top:12rpx;display:flex;flex-wrap:wrap;gap:12rpx 20rpx}.miss-name{font-size:26rpx;color:#8a5a12;background:#fdeccc;border-radius:8rpx;padding:4rpx 16rpx}.empty,.loading{padding:100rpx;text-align:center;color:#8993a4}
