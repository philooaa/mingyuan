<view class="page">
  <view wx:if="{{!courseId}}" class="todo-hero">
    <view class="hero-copy">
      <view class="hero-eyebrow">课程出勤</view>
      <view class="hero-title">{{role === 'teacher' ? '教师点名' : role === 'education' ? '教务初审' : '出勤终审'}}</view>
      <view class="hero-description">{{role === 'teacher' ? '核对学员名单，登记本课出勤' : role === 'education' ? '核对出勤记录，上传监控截图' : '查看出勤与截图，完成最终确认'}}</view>
    </view>
    <view wx:if="{{role !== 'teacher'}}" class="hero-count"><text class="hero-number">{{loading ? '—' : totalCount}}</text><text class="hero-count-label">待处理课次</text></view>
  </view>

  <view class="todo-filters" wx:if="{{!courseId}}">
    <view class="filter-title">{{role === 'teacher' ? '筛选班级' : '筛选课次'}}</view>
    <view class="attendance-filter-buttons">
      <picker wx:for="{{role === 'teacher' ? ['year','termName','gradeName'] : ['year','termName','teacherName','lessonNo','gradeName']}}" wx:key="*this" range="{{filterOptions[item]}}"
        value="{{filterIndexes[item]}}" data-field="{{item}}" bindchange="onAttendanceFilter">
        <view class="attendance-filter-button {{attendanceFilters[item]?'chosen':''}}">
          {{item === 'lessonNo' && attendanceFilters[item] ? '第 ' + attendanceFilters[item] + ' 讲' : (attendanceFilters[item] || filterOptions[item][0] || '')}} ▾
        </view>
      </picker>
      <button class="attendance-filter-reset" size="mini" bindtap="resetAttendanceFilters">重置筛选</button>
    </view>
    <button wx:if="{{role === 'teacher'}}" class="course-query-button" hover-class="course-query-pressed" bindtap="queryCourses" disabled="{{loading}}">查询班级</button>
  </view>
  <block wx:if="{{role === 'teacher' && !courseId}}">
    <view class="todo-card" wx:for="{{matchedCourses}}" wx:key="scheduleId" data-index="{{index}}" bindtap="chooseCourse">
      <view class="course-heading"><view class="course-name">{{item.courseName}}</view><text class="action-arrow">›</text></view>
      <view class="course-tags"><text>{{item.year}} {{item.termName}}</text><text>{{item.gradeName}}</text></view>
    </view>
    <view class="empty-state" wx:if="{{queried && !loading && !error && !matchedCourses.length}}">没有符合条件的班级</view>
  </block>
  <view wx:if="{{role === 'teacher' && courseId}}" class="selected-course">
    <button class="course-back-button" size="mini" bindtap="backToCourses">‹ 返回班级</button>
    <view class="selected-course-title">{{courseTitle}}</view>
    <view class="selected-course-meta">
      <text>共 {{totalCount}} 讲</text>
      <text wx:if="{{overdueCount}}" class="selected-course-overdue">{{overdueCount}} 讲待补点名</text>
    </view>
  </view>
  <block wx:if="{{role !== 'teacher' || courseId}}">
  <view wx:if="{{role !== 'teacher'}}" class="todo-list-heading">
    <view class="list-title">待审核课次<text class="list-count">{{count}}</text></view>
    <text class="list-caption">{{count === totalCount ? '点击课次开始审核' : '已筛选 · 共 ' + totalCount + ' 课次'}}</text>
  </view>

  <view wx:if="{{role === 'teacher'}}" class="lesson-grid">
    <button wx:for="{{items}}" wx:key="rowKey" data-index="{{index}}" bindtap="open"
      class="lesson-button {{item.attendanceTone}}" hover-class="lesson-button-pressed">
      <text class="lesson-number">{{item.lessonNo ? '第 ' + item.lessonNo + ' 讲' : '课次'}}</text>
      <text class="lesson-date">{{item.shortClassDate}}</text>
      <view class="lesson-status"><text class="lesson-dot"></text><text>{{item.attendanceLabel}}</text></view>
    </button>
  </view>
  <block wx:else>
  <view class="todo-card" wx:for="{{items}}" wx:key="rowKey" data-index="{{index}}" bindtap="open" hover-class="todo-card-pressed">
    <view class="course-heading"><view class="course-name">{{item.courseName || '未命名课程'}}</view><text class="stage-tag {{item.overdue ? 'overdue' : ''}}">{{role === 'education' ? '待初审' : '待终审'}}</text></view>
    <view class="course-tags"><text wx:if="{{item.gradeName}}">{{item.gradeName}}</text><text wx:if="{{item.subjectName}}">{{item.subjectName}}</text><text wx:if="{{item.lessonNo}}">第 {{item.lessonNo}} 讲</text></view>
    <view class="course-teacher" wx:if="{{item.teacherName}}">任课教师 · {{item.teacherName}}</view>
    <view class="course-date"><text class="date-label">上课日期</text><text>{{item.classDate}}</text><text class="course-time" wx:if="{{item.startTime && item.endTime}}">{{item.startTime}}–{{item.endTime}}</text></view>
    <view class="course-footer"><view class="expected-count">应到 <text>{{item.expectedCount || 0}}</text> 人</view><view class="course-action">{{role === 'education' ? '去初审' : '去终审'}}<text class="action-arrow">›</text></view></view>
  </view>

  </block>
  <view class="empty-state" wx:if="{{!loading && !error && !items.length}}"><view class="empty-icon">✓</view><view class="empty-title">{{role === 'teacher' && !courseId ? '请先选择班级' : '没有符合条件的课次'}}</view><view class="empty-description">{{totalCount ? '试试调整筛选条件' : '有新的出勤待办时，会显示在这里'}}</view></view>
  </block>
  <view class="error-card" wx:if="{{error}}"><view>{{error}}</view><button class="retry-button" bindtap="load">重新加载</button></view>
  <view class="loading-state" wx:if="{{loading}}">正在加载…</view>
</view>
