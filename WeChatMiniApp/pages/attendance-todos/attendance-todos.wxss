@import "../../utils/attendance-filters.wxss";
.page { min-height: 100vh; padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background: #f4f6fa; color: #233852; }
.todo-hero { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 32rpx 28rpx; border: 1rpx solid #e4edf9; border-radius: 24rpx; background: linear-gradient(120deg,#eaf2ff 0%,#f8fbff 100%); }
.hero-copy { flex: 1; min-width: 0; }
.hero-eyebrow { color: #6686ae; font-size: 22rpx; letter-spacing: 2rpx; }
.hero-title { margin-top: 8rpx; color: #193e6b; font-size: 38rpx; font-weight: 600; }
.hero-description { margin-top: 12rpx; color: #7a8da5; font-size: 23rpx; line-height: 1.6; }
.hero-count { display: flex; flex: 0 0 136rpx; flex-direction: column; align-items: center; gap: 6rpx; padding: 16rpx 0 16rpx 16rpx; border-left: 1rpx solid #d9e6f6; }
.hero-number { color: #24599a; font-size: 56rpx; font-weight: 600; line-height: 1.15; }
.hero-count-label { color: #7890ae; font-size: 21rpx; white-space: nowrap; }
.todo-filters { position: relative; margin-top: 24rpx; padding: 26rpx 24rpx 24rpx; background: #fff; border: 1rpx solid #e9eef5; border-radius: 24rpx; }
.filter-title { color: #2d4564; font-size: 27rpx; font-weight: 600; }
.todo-filters .attendance-filter-buttons { gap: 14rpx; margin: 22rpx 0 0; padding: 0; border-radius: 0; }
.todo-filters .attendance-filter-buttons picker { flex: 1 1 42%; }
.todo-filters .attendance-filter-button { min-height: 76rpx; padding: 20rpx 16rpx; border: 1rpx solid #eaf0f7; border-radius: 14rpx; background: #f6f8fc; color: #586e8b; font-size: 25rpx; line-height: 1.5; }
.todo-filters .attendance-filter-button.chosen { border-color: #d6e5f8; background: #edf4ff; color: #245eaa; }
.todo-filters .attendance-filter-reset { position: absolute; top: 20rpx; right: 24rpx; width: auto; min-height: 44rpx; margin: 0; padding: 0; background: transparent; color: #7087a4; font-size: 23rpx; font-weight: 400; line-height: 44rpx; }
.todo-filters .attendance-filter-reset::after { border: 0; }
.todo-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 4rpx 18rpx; }
.list-title { display: flex; align-items: center; gap: 12rpx; color: #30465f; font-size: 28rpx; font-weight: 600; }
.list-count { min-width: 36rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: #e6eefb; color: #2c62a3; font-size: 21rpx; text-align: center; }
.list-caption { color: #929eae; font-size: 21rpx; }
.todo-card { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #e9eef5; border-radius: 24rpx; background: #fff; }
.todo-card-pressed { background: #f8fbff; }
.course-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.course-name { flex: 1; min-width: 0; color: #203f65; font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.stage-tag { flex-shrink: 0; margin-top: 4rpx; padding: 5rpx 12rpx; border-radius: 8rpx; background: #edf4ff; color: #3a70ac; font-size: 20rpx; line-height: 1.5; white-space: nowrap; }
.stage-tag.overdue { background: #fff1e4; color: #b6792c; }
.course-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.course-tags text { padding: 5rpx 12rpx; border-radius: 7rpx; background: #f2f5f9; color: #7588a1; font-size: 21rpx; line-height: 1.5; }
.course-teacher { margin-top: 18rpx; color: #8291a5; font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.course-date { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 12rpx; color: #657c98; font-size: 23rpx; line-height: 1.6; }
.date-label { color: #a0adbc; }
.course-time { color: #7d91ab; }
.course-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #eef2f7; }
.expected-count { color: #8b99ab; font-size: 24rpx; }
.expected-count text { margin: 0 5rpx; color: #294b75; font-size: 28rpx; font-weight: 600; }
.course-action { display: flex; align-items: center; gap: 16rpx; color: #2d67ad; font-size: 25rpx; font-weight: 500; }
.action-arrow { font-size: 32rpx; font-weight: 400; line-height: 1; }
.overdue-tip, .error-card { margin-bottom: 20rpx; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.6; }
.overdue-tip { background: #fff4e8; color: #ad7c3c; }
.error-card { background: #fff0ed; color: #b76252; }
.error-card .retry-button { width: 180rpx; height: 64rpx; margin: 16rpx 0 0; padding: 0; border-radius: 10rpx; background: #fff; color: #a45f52; font-size: 24rpx; line-height: 64rpx; }
.error-card .retry-button::after { border: 0; }
.loading-state { padding: 60rpx 0; color: #96a5b8; font-size: 25rpx; text-align: center; }
.empty-state { padding: 64rpx 20rpx; text-align: center; }
.empty-icon { width: 84rpx; height: 84rpx; margin: 0 auto 20rpx; border-radius: 50%; background: #e7eef8; color: #86a2c5; font-size: 40rpx; line-height: 84rpx; }
.empty-title { color: #607896; font-size: 28rpx; }
.empty-description { margin-top: 12rpx; color: #9aa9bb; font-size: 23rpx; }
