<view class="page"><view class="header"><view class="header-title">{{detail.title || '作业详情'}}</view><view class="header-subtitle">{{detail.description || '请阅读作业说明并提交'}}</view></view>
<view class="card" wx:if="{{homeworkFiles.length}}"><view class="section-title">老师布置的附件</view><view wx:for="{{homeworkFiles}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile"/><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.fileName}}" bindtap="openFile">📄　{{item.showName}}</view></view></view>
<view class="card"><textarea class="answer" placeholder="请输入作业说明或完成情况" auto-height value="{{description}}" bindinput="inputDescription" disabled="{{submitted}}"/></view><view class="card"><view class="section-title">我的提交附件</view><view class="btn-row" wx:if="{{!submitted}}"><button size="mini" bindtap="chooseFile">上传附件（图片/PDF/文档/音频/视频）</button></view><view wx:for="{{files}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile"/><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.fileName}}" bindtap="openFile">📄　{{item.showName}}</view><text wx:if="{{!submitted}}" class="remove" data-index="{{index}}" bindtap="removeFile">删除</text></view><view wx:if="{{submitted}}" class="success">已提交，每名学生每份作业只能提交一次</view></view><view class="card" wx:if="{{reviewed}}"><view class="section-title">老师批阅</view><view class="review-score">得分：<text class="review-score-num">{{reviewScore !== '' ? reviewScore : '-'}}</text> 分</view><view class="review-comment" wx:if="{{reviewComment}}">评语：<text user-select>{{reviewComment}}</text></view><view class="review-time" wx:if="{{reviewTime}}">批阅时间：{{reviewTime}}</view><view class="section-title" wx:if="{{reviewFiles.length}}" style="margin-top:20rpx">批阅附件</view><view wx:for="{{reviewFiles}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile"/><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.fileName}}" bindtap="openFile">📄　{{item.showName}}</view></view></view><view class="review-pending" wx:if="{{submitted && !reviewed}}">已提交，等待老师批阅</view><button wx:if="{{!submitted}}" class="submit" loading="{{submitting}}" bindtap="submit">提交作业</button></view>
