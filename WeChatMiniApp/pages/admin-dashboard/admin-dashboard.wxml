<view class="page">
 <view class="topbar"><view wx:if="{{section !== 'home'}}" class="back" bindtap="goBack">‹ 返回</view><view class="title">{{section === 'home' ? '教学数据看板' : section === 'lessons' ? '本周消课' : section === 'history' ? '历周消课统计' : section === 'teachers' ? '教师学生数' : section === 'finance' ? '财务驾驶舱' : section === 'finance-months' ? '月度财务' : section === 'finance-sources' ? '收入来源' : section === 'salaries' ? '教师工资' : section === 'expenses' ? '成本支出' : '本周退费明细'}}</view></view>
 <view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="card" bindtap="load">{{error}}，点击重试</view>
 <block wx:if="{{section === 'home'}}">
  <picker mode="date" value="{{date}}" bindchange="dateChange"><view class="card">选择日期：{{date}}　›<view class="muted">统计周：{{weekStart}} 至 {{weekEnd}}</view></view></picker>
  <view class="menu-grid">
   <view class="menu-card" data-section="lessons" bindtap="openSection"><view class="menu-icon">课</view><view class="menu-title">本周消课</view><view class="muted">{{total}} 人次 · 查看每讲明细</view></view>
   <view class="menu-card" data-section="history" bindtap="openSection"><view class="menu-icon">统</view><view class="menu-title">统计数据</view><view class="muted">查看此前各周消课</view></view>
   <view class="menu-card" data-section="teachers" bindtap="openSection"><view class="menu-icon">师</view><view class="menu-title">教师学生数</view><view class="muted">按课程、时段、季度筛选</view></view>
   <view class="menu-card" data-section="finance" bindtap="openSection"><view class="menu-icon">财</view><view class="menu-title">财务驾驶舱</view><view class="muted">收入、成本及利润</view></view>
  </view>
 </block>
 <block wx:if="{{section === 'lessons'}}">
  <picker mode="date" value="{{date}}" bindchange="dateChange"><view class="card">{{date}}　›<view class="muted">统计周：{{weekStart}} 至 {{weekEnd}}</view></view></picker>
  <view class="card"><view class="heading">本周消课 {{total}} 人次</view><view class="muted">已复核到课；一对一按 1.5 人次计算</view></view>
  <view class="heading">每讲消课</view><view wx:if="{{!loading && !error && !lessons.length}}" class="muted">本周暂无记录</view>
  <view class="card" wx:for="{{lessons}}" wx:key="index" data-index="{{index}}" bindtap="showLesson"><view>{{item.courseClassName}} · {{item.consumptionCount}} 人次　›</view><view class="muted">{{item.classDate}} {{item.timeSlot}} · {{item.teacherName}} · 实际到课 {{item.actualCount}} 人</view></view>
 </block>
 <block wx:if="{{section === 'history'}}"><view class="muted">不含本周，每次查看更早 12 周</view><view wx:for="{{historyRows}}" wx:key="weekStart" class="card">{{item.weekStart}} 起 · {{item.consumptionCount}} 人次<view class="muted">实际到课 {{item.actualCount}} 人次</view></view><view wx:if="{{!historyRows.length && !historyLoading && !historyError}}" class="card">该时间范围暂无记录</view><view wx:if="{{historyError}}" class="card" bindtap="retryHistory">{{historyError}} · 点击重试</view><button bindtap="moreHistory" loading="{{historyLoading}}" disabled="{{historyLoading}}">查看更早 12 周</button></block>
 <block wx:if="{{section === 'teachers'}}"><view class="muted">按课程分别计数，同一学生报多门课重复计数</view><view class="filters"><picker range="{{terms}}" value="{{termIndex}}" data-key="termIndex" bindchange="change"><view>{{terms[termIndex]}} ▾</view></picker><picker range="{{courses}}" value="{{courseIndex}}" data-key="courseIndex" bindchange="change"><view>{{courses[courseIndex]}} ▾</view></picker><picker range="{{times}}" value="{{timeIndex}}" data-key="timeIndex" bindchange="change"><view>{{times[timeIndex]}} ▾</view></picker></view><view wx:if="{{!loading && !error && !teachers.length}}" class="muted">暂无符合条件的数据</view><view class="card" wx:for="{{teachers}}" wx:key="key">{{item.name}} <text class="count">{{item.count}} 人</text></view></block>
 <block wx:if="{{section === 'finance'}}"><view class="muted">按所选日期统计；工资按月度金额和所选天数比例分摊</view><view class="filters"><picker mode="date" value="{{beginDate}}" data-key="beginDate" bindchange="financeDate"><view>开始：{{beginDate}} ▾</view></picker><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="financeDate"><view>结束：{{endDate}} ▾</view></picker></view><view wx:if="{{financeLoading}}" class="muted">正在加载财务数据…</view><view wx:if="{{financeError}}" class="card" bindtap="loadFinance">{{financeError}} · 点击重试</view><view wx:if="{{!finance && !financeLoading && !financeError}}" class="muted">财务驾驶舱需要相应权限</view>
 <view class="finance-grid" wx:if="{{finance}}"><view class="finance-item">确认收入<view>{{finance.summary.confirmedRevenue}} 元</view></view><view class="finance-item">退款<view>{{finance.summary.refundTotal}} 元</view></view><view class="finance-item">合同金额<view>{{finance.summary.contractAmount}} 元</view></view><view class="finance-item">欠款<view>{{finance.summary.receivable}} 元</view></view><view class="finance-item" data-section="salaries" bindtap="openSection">教师工资 ›<view>{{finance.summary.teacherSalary}} 元</view></view><view class="finance-item" data-section="expenses" bindtap="openSection">成本支出 ›<view>{{finance.summary.expenseTotal}} 元</view></view><view class="finance-item">毛利<view>{{finance.summary.grossProfit}} 元</view></view><view class="finance-item">净利润<view>{{finance.summary.netProfit}} 元</view></view></view>
 <view class="card" wx:if="{{finance}}" data-section="finance-sources" bindtap="openSection">收入来源　›</view><view class="card" data-section="refunds" bindtap="openSection">本周退费明细 · {{refundTotal}} 元　›</view></block>
 <block wx:if="{{section === 'salaries' || section === 'expenses'}}"><view class="muted">{{beginDate}} 至 {{endDate}}</view><view wx:if="{{section === 'salaries'}}" class="muted">点击录入或修改整月工资，区间金额按天数分摊。已确认记录也可修改；未生成的月工资可手工录入。</view><view wx:else class="muted">点击记录修改成本金额；新增成本日期为所选结束日期</view><button wx:if="{{section === 'expenses'}}" bindtap="addExpense" disabled="{{entrySaving}}">新增成本</button><view wx:if="{{entriesLoading}}" class="muted">加载中…</view><view wx:if="{{entriesError}}" class="card" bindtap="reloadEntries">{{entriesError}} · 点击重试</view><view wx:if="{{!entriesLoading && !entriesError && !entries.length}}" class="card">当前区间暂无记录</view><view class="card" wx:for="{{entries}}" wx:key="index" data-index="{{index}}" bindtap="editEntry"><block wx:if="{{section === 'salaries'}}"><view>{{item.teacherName}} · {{item.salaryMonth}}　›</view><view wx:if="{{item.missing}}" class="muted">尚无工资记录 · 点击录入</view><view wx:else class="muted">整月 {{item.totalAmount}} 元 · 区间 {{item.periodAmount}} 元 · {{item.confirmStatus === '1' ? '已确认' : '待确认'}}</view></block><block wx:else><view>{{item.title}} · {{item.amount}} 元　›</view><view class="muted">{{item.expenseDate}} · {{item.detail}}</view></block></view></block>
 <block wx:if="{{section === 'finance-months'}}"><view class="card" wx:for="{{finance.monthlyTrend}}" wx:key="month">{{item.month}}<view class="muted">收入 {{item.confirmedRevenue}} 元 · 净利润 {{item.netProfit}} 元</view></view></block>
 <block wx:if="{{section === 'finance-sources'}}"><view class="card" wx:for="{{finance.revenueBySource}}" wx:key="name">{{item.name}}：{{item.value}} 元</view></block>
 <block wx:if="{{section === 'refunds'}}"><view class="muted">{{weekStart}} 至 {{weekEnd}}</view><view wx:if="{{!refunds.length}}" class="card">本周暂无成功退费</view><view class="card" wx:for="{{refunds}}" wx:key="refundId">{{item.studentName}} · {{item.approvedAmount}} 元<view class="muted">{{item.completedTime}}</view></view></block>
 <view class="overlay" wx:if="{{detailOpen}}"><view class="panel"><view class="heading">{{detailTitle}}</view><view class="muted" bindtap="closeDetail">关闭 ×</view><scroll-view scroll-y class="panel-list"><view wx:if="{{detailLoading}}">加载中…</view><view wx:if="{{detailError}}">{{detailError}}</view><view wx:for="{{detailRows}}" wx:key="recordKey" class="card">{{item.studentName}} · {{item.courseClassName}} · {{item.consumptionCount}} 人次</view><view wx:if="{{!detailLoading && !detailError && !detailRows.length}}">暂无记录</view></scroll-view></view></view>
</view>
