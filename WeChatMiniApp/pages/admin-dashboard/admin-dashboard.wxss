.page{padding:28rpx;background:#f4f7fb;min-height:100vh;color:#1b2b43}.title{font-size:40rpx;font-weight:700;margin-bottom:24rpx}.heading{font-size:32rpx;font-weight:600;margin:28rpx 0 16rpx}.card{background:#fff;border-radius:18rpx;padding:24rpx;margin:14rpx 0}.muted{font-size:25rpx;color:#788697;margin-top:10rpx}.filters{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.filters picker{background:white;padding:14rpx;border-radius:12rpx;max-width:100%}.count{float:right;color:#1863bd;font-weight:600}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;z-index:20}.panel{background:#f4f7fb;border-radius:24rpx 24rpx 0 0;padding:28rpx;width:100%}.panel-list{height:65vh}
.topbar{display:flex;align-items:center;gap:20rpx}.back{color:#2566b5;white-space:nowrap;margin-bottom:24rpx}.menu-grid,.finance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.menu-card,.finance-item{background:#fff;border-radius:18rpx;padding:24rpx;min-width:0}.menu-icon{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;background:#eaf2ff;color:#2465b2;border-radius:16rpx;font-weight:700}.menu-title{font-weight:700;font-size:30rpx;margin-top:16rpx}.finance-item{color:#788697;font-size:25rpx}.finance-item view{color:#17375c;font-weight:700;font-size:30rpx;margin-top:10rpx;word-break:break-all}
