@import "../../styles/education-ui.wxss";
page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.header {
  margin: 0 24rpx 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.logo {
  width: 320rpx;
}

.header-title {
  margin-top: 22rpx;
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 25rpx;
  line-height: 1.55;
}

.course-type-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 24rpx 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.course-type-label {
  color: #334257;
  font-size: 25rpx;
  font-weight: 700;
}

.course-type-picker {
  flex: 1;
}

.course-type-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 44rpx;
  color: #0b326a;
  font-size: 27rpx;
  font-weight: 700;
}

.course-type-arrow {
  color: #6e7a8c;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx 22rpx;
  align-items: center;
}

.filter-picker {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.filter-text {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 25rpx;
  color: #172033;
}

.icon-btn {
  width: 88rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #ffffff;
  color: #526175;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
}

.icon-btn.reset {
  border: 1rpx solid #dce5f2;
}

.section {
  margin: 24rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.schedule-card,
.enroll-card {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.schedule-card:active {
  transform: scale(0.99);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.course-name {
  color: #172033;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.meta {
  margin-top: 8rpx;
  color: #6e7a8c;
  font-size: 23rpx;
  line-height: 1.35;
}

.count {
  color: #0b326a;
  font-size: 26rpx;
  font-weight: 800;
}

.status,
.done {
  margin-top: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status.ok,
.done {
  background: #eaf7f1;
  color: #15875d;
}

.status.disabled {
  background: #eef1f5;
  color: #7a8492;
}

.empty {
  padding: 42rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #778397;
  font-size: 25rpx;
  text-align: center;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(8, 22, 40, 0.42);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  padding: 30rpx 28rpx 42rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(9, 25, 48, 0.18);
}

.sheet-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-course {
  margin-top: 14rpx;
  color: #0b326a;
  font-size: 29rpx;
  font-weight: 800;
}

.sheet-meta {
  margin-top: 8rpx;
  color: #6e7a8c;
  font-size: 24rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #334257;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 14rpx;
  background: #f9fbff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.cancel-btn {
  background: #eef2f7;
  color: #526175;
}

.submit-btn {
  background: #0f58a8;
  color: #ffffff;
}
.tuition-btn { margin-top: 14rpx; background: #edf4ff; color: #0b326a; font-size: 24rpx; border-radius: 14rpx; }

.teacher-filter { margin: 0 24rpx 22rpx; padding: 20rpx; border-radius: 14rpx; background: white; }
.teacher-filter-title { color: #0b326a; font-size: 26rpx; font-weight: 700; }
.teacher-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.teacher-tag { margin-top: 14rpx; padding: 10rpx 14rpx; border-radius: 12rpx; color: #0f58a8; background: #eaf3ff; font-size: 23rpx; }
.teacher-search { margin-top: 18rpx; height: 72rpx; font-size: 25rpx; border-bottom: 1rpx solid #dce5f2; }
.teacher-filter-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 0; }
.teacher-filter-actions button { margin: 0; color: #0f58a8; background: #eaf3ff; font-size: 23rpx; }
.teacher-filter-hint { margin-bottom: 12rpx; line-height: 1.6; }
.teacher-options { max-height: 360rpx; }
.teacher-option { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 10rpx; font-size: 25rpx; }
.teacher-option.selected { background: #eaf3ff; color: #0f58a8; }
.course-group-title { margin: 24rpx 0 14rpx; font-size: 27rpx; font-weight: 700; color: #0b326a; }

.teacher-tag, .teacher-option, .course-group-title { white-space: normal; word-break: break-all; }
.single-course-card { margin-bottom:18rpx; border-radius:16rpx; background:white; overflow:hidden; border:1rpx solid rgba(18,41,72,.06); }
.single-course-heading { padding:22rpx; }
.date-toggle { margin-top:18rpx; color:#0f58a8; font-size:25rpx; font-weight:700; }
.single-date-list { padding:0 22rpx 12rpx; }
.single-date-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:18rpx 0; border-top:1rpx solid #e5ebf3; font-size:24rpx; color:#334257; }
.single-date-row .status { margin:0; flex-shrink:0; }

/* 教育业务页面：紧凑布局与信息层级 */

.header { margin:0; padding:28rpx 28rpx 22rpx; border-radius:0; background:transparent; box-shadow:none; }
.header-title { margin-top:0; color:#202b3d; font-size:38rpx; font-weight:700; }
.header-subtitle { color:#68778c; font-size:24rpx; margin-top:6rpx; }
.course-type-bar { gap:6rpx; padding:6rpx; margin:0 24rpx 20rpx; border:1rpx solid #e8edf4; background:#edf0f6; border-radius:14rpx; }
.course-type-tab { flex:1; text-align:center; padding:20rpx 0; font-size:28rpx; color:#68778c; border-radius:10rpx; }
.course-type-tab.selected { background:#fff; color:#2459d9; font-weight:700; box-shadow:0 2rpx 6rpx #2030500a; }
.filter-bar { margin-bottom:14rpx; }
.filter-picker,.icon-btn { border-color:#e8edf4; border-radius:12rpx; }
.teacher-filter { padding:20rpx; margin-bottom:20rpx; border:1rpx solid #e8edf4; border-radius:14rpx; }
.teacher-filter-title { color:#52627a; font-size:25rpx; font-weight:500; }
.teacher-tag { background:#edf2ff; color:#2459d9; border-radius:8rpx; }
.course-group-title { display:flex; align-items:center; margin:24rpx 0 14rpx; font-size:26rpx; color:#52627a; }
.section-title { font-size:30rpx; font-weight:700; }
.schedule-card,.enroll-card,.single-course-card { border-color:#e8edf4; box-shadow:none; border-radius:18rpx; }
.schedule-card,.enroll-card { padding:24rpx; }
.single-course-heading { padding:24rpx; }
.course-name { font-size:30rpx; font-weight:700; line-height:1.5; word-break:break-word; }
.meta { font-size:24rpx; color:#68778c; line-height:1.6; }
.card-side { min-width:110rpx; gap:16rpx; }
.count { font-size:28rpx; color:#2459d9; white-space:nowrap; }
.status,.done { border-radius:8rpx; font-weight:500; padding:6rpx 12rpx; margin-top:10rpx; white-space:nowrap; }
.enroll-card > view:first-child { flex:1; min-width:0; }
.enroll-card > view:last-child { flex-shrink:0; text-align:right; max-width:220rpx; }
.enroll-card button { margin:14rpx 0 0 auto; padding:0 14rpx; color:#2459d9; background:#edf2ff; font-size:23rpx; }
.date-toggle { margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid #edf1f6; color:#2459d9; font-size:25rpx; }
.single-date-row { font-size:26rpx; }
.sheet { max-height:86vh; overflow-y:auto; box-sizing:border-box; padding-bottom:calc(28rpx + env(safe-area-inset-bottom)); }
.sheet-course { color:#202b3d; line-height:1.5; }
.sheet-meta { color:#68778c; line-height:1.5; }
.input { background:#f7f9fc; border-color:#e8edf4; border-radius:12rpx; }
.submit-btn { background:#2459d9; }
.empty { border:1rpx dashed #e0e6ef; font-size:25rpx; background:transparent; }
.settlement-options { display:flex; gap:16rpx; margin:22rpx 0; }.settlement-option { flex:1; padding:20rpx 0; text-align:center; border:1rpx solid #dfe5ee; border-radius:12rpx; color:#68778c; }.settlement-option.selected { background:#edf2ff; border-color:#2459d9; color:#2459d9; }.credit-account { padding:18rpx 0; border-bottom:1rpx solid #edf0f4; font-size:26rpx; }.credit-available { float:right; color:#2459d9; font-weight:600; }
.booking-wallet{margin:0 24rpx 24rpx;padding:28rpx;border:1rpx solid #dce8fa;border-radius:24rpx;background:linear-gradient(125deg,#eaf2ff,#f5f9ff 80%,#fff7e7);color:#264774}
.wallet-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wallet-eyebrow{font-size:23rpx;color:#6882a6}.wallet-child{font-size:28rpx;font-weight:650;margin-top:8rpx}.wallet-mark{font-size:34rpx;color:#8aa7d5;letter-spacing:5rpx;font-weight:700}
.wallet-stats{display:flex;align-items:center;margin-top:28rpx}.wallet-primary{flex:1.3}.wallet-secondary{flex:1;text-align:center;border-left:1rpx solid #dce6f5}.wallet-value{font-size:62rpx;font-weight:750;line-height:1.2;color:#204d93}.wallet-value text{font-size:24rpx;font-weight:400}.wallet-small-value{font-size:34rpx;font-weight:650;line-height:1.4}.wallet-label{font-size:22rpx;color:#7a8eaa;margin-top:8rpx}
.wallet-actions{display:flex;justify-content:space-between;align-items:center;margin-top:26rpx}.wallet-history{font-size:24rpx;color:#557aaf;padding:12rpx 0}.wallet-buy{margin:0;padding:0 28rpx;height:70rpx;line-height:70rpx;border-radius:14rpx;background:#2459d9;color:#fff;font-size:25rpx;font-weight:600}.wallet-buy::after{border:0}.wallet-buy[disabled]{background:#a7bad9;color:white}
.wallet-footnote{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #dfe8f5;color:#8594a9;font-size:21rpx;line-height:1.6}.wallet-state{padding:24rpx 0;font-size:25rpx;color:#7589a5;line-height:1.7}.wallet-error{color:#ab6949}

/* 课程定价与购物车 */
.price-text { color:#b4622a; font-weight:600; }
.cart-add { margin-top:14rpx; padding:8rpx 14rpx; border:1rpx solid #2459d9; border-radius:10rpx; color:#2459d9; font-size:22rpx; text-align:center; white-space:nowrap; }
.cart-add.in { border-color:#c7d2e4; color:#8b98ab; background:#f4f6fa; }
.cart-bar { position:fixed; left:0; right:0; bottom:0; z-index:12; display:flex; align-items:center; justify-content:space-between; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background:#ffffff; border-top:1rpx solid #e8edf4; box-shadow:0 -10rpx 28rpx rgba(9,25,48,0.10); }
.cart-bar-info { flex:1; min-width:0; }
.cart-bar-count { font-size:24rpx; color:#68778c; }
.cart-bar-total { font-size:32rpx; font-weight:750; color:#b4622a; margin-top:4rpx; }
.cart-bar-actions { display:flex; align-items:center; gap:18rpx; }
.cart-bar-clear { padding:12rpx 18rpx; font-size:24rpx; color:#8b98ab; }
.cart-bar-go { padding:14rpx 34rpx; border-radius:14rpx; background:#2459d9; color:#ffffff; font-size:27rpx; font-weight:600; }
.cart-list { margin-top:18rpx; max-height:44vh; overflow-y:auto; }
.cart-item { display:flex; align-items:flex-start; justify-content:space-between; padding:18rpx 0; border-bottom:1rpx solid #edf1f6; }
.cart-item-main { flex:1; min-width:0; }
.cart-item-side { flex-shrink:0; text-align:right; margin-left:18rpx; }
.cart-item-amount { font-size:28rpx; font-weight:700; color:#b4622a; }
.cart-item-remove { margin-top:10rpx; font-size:23rpx; color:#8b98ab; }
.cart-total-row { display:flex; align-items:center; justify-content:space-between; margin:22rpx 0 12rpx; padding-top:18rpx; border-top:1rpx solid #e8edf4; font-size:27rpx; color:#3a4a63; }
.cart-total-value { font-size:34rpx; font-weight:800; color:#b4622a; }

.filter-bar{flex-wrap:nowrap;gap:10rpx}.filter-picker{min-width:0;padding:0 12rpx}.term-picker{flex:1.2}.filter-text{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.filter-bar .reset{flex-shrink:0;width:76rpx}

/* 下单成功说明弹窗：标题 + 缴费引导 + 课程服务老师二维码 */
.order-done-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:999; display:flex; align-items:center; justify-content:center; padding:0 48rpx; background:rgba(15,25,45,0.45); }
.order-done { width:100%; max-width:620rpx; padding:44rpx 36rpx 32rpx; border-radius:24rpx; background:#fff; text-align:center; box-shadow:0 24rpx 60rpx rgba(15,25,45,0.18); }
.order-done-title { color:#172033; font-size:34rpx; font-weight:700; }
.order-done-text { margin-top:20rpx; color:#52627a; font-size:26rpx; line-height:1.8; }
.order-done-qr { display:block; width:100%; max-width:380rpx; margin:24rpx auto 0; border-radius:12rpx; }
.order-done-wechat-row { display:flex; align-items:center; justify-content:center; gap:12rpx; margin-top:20rpx; }
.order-done-wechat { color:#68778c; font-size:24rpx; line-height:1.6; word-break:break-all; }
.order-done-copy { flex-shrink:0; padding:6rpx 16rpx; border-radius:8rpx; background:#edf2ff; color:#2459d9; font-size:22rpx; }
.order-done-btn { margin-top:28rpx; border-radius:12rpx; background:#2459d9; color:#fff; font-size:28rpx; font-weight:600; line-height:88rpx; }
.order-done-btn::after { border:none; }
