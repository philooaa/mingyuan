@import "../../styles/number-badge.wxss";

page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.home {
  height: 100vh;
  box-sizing: border-box;
}

.hero {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx 34rpx;
  overflow: hidden;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 50%, #fff4df 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.hero::after {
  content: "";
  position: absolute;
  right: -90rpx;
  bottom: -110rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(246, 166, 35, 0.16);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.logo {
  width: 380rpx;
  max-height: 118rpx;
}

.tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(16, 82, 155, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #0f4f9a;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.account-toolbar {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.logout-button {
  margin: 0;
  color: #0f4f9a;
  background: #fff;
  border-radius: 999rpx;
}

.role-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44rpx;
  padding: 8rpx 20rpx;
  white-space: nowrap;
}

.role-arrow {
  color: #3572b5;
  font-size: 22rpx;
}

.role-label-pressed {
  background: #dceaff;
}

.eyebrow {
  color: #f09a16;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  color: #0b326a;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.stats {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.stat {
  flex: 1;
  min-height: 116rpx;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.stat-value {
  color: #103f86;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
}

.stat-value text {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 12rpx;
  color: #657184;
  font-size: 22rpx;
}

.stats-teacher {
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.stats-teacher .stat {
  flex: 1 1 0;
  min-width: 0;
  padding: 18rpx 10rpx;
}

.stats-teacher .stat-label,
.stats-teacher .stat-link {
  font-size: 20rpx;
  white-space: nowrap;
}

.stat-clickable {
  border: 1rpx solid rgba(16, 63, 134, 0.06);
}

.stat-pressed {
  background: #e3edfc;
}

.stat-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #2865b2;
  font-size: 22rpx;
}

.stat-link text {
  font-size: 28rpx;
  line-height: 1;
}

.section {
  margin: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #172033;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.action-card {
  width: calc(25% - 16rpx);
  min-height: 132rpx;
  margin: 8rpx;
  padding: 20rpx 10rpx 16rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.06);
  box-sizing: border-box;
  text-align: center;
}

.action-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-disabled {
  opacity: 0.45;
}

.action-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 12rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.action-title {
  color: #1c2738;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.course-pending-message { margin-top:16rpx; color:#657184; font-size:22rpx; line-height:1.6; }
.pending-retry { margin-left:14rpx; color:#0f58a8; }

.blue .action-icon { background: #0f58a8; }
.green .action-icon { background: #20a06b; }
.orange .action-icon { background: #f19a19; }
.cyan .action-icon { background: #1598b7; }
.violet .action-icon { background: #7f63d7; }
.gold .action-icon { background: #d99b16; }
.red .action-icon { background: #df6557; }
.indigo .action-icon { background: #3656b3; }

.split {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 44rpx;
}

.panel {
  padding: 24rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.course {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  min-height: 104rpx;
  margin-top: 18rpx;
}

.course-time-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 140rpx;
  flex: 0 0 auto;
  padding-top: 2rpx;
}

.course-meta-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #c27a08;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.course-meta-sep {
  opacity: 0.55;
  color: #c27a08;
}

.course-time {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 64rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  background: #eef5ff;
  color: #0f58a8;
  font-size: 24rpx;
  font-weight: 700;
}

.course-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.course-name {
  color: #172033;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.course-meta {
  margin-top: 8rpx;
  color: #7b8798;
  font-size: 22rpx;
  line-height: 1.3;
}

.course-status {
  align-self: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3dc;
  color: #c27a08;
  font-size: 21rpx;
  font-weight: 700;
}

.teacher-switch {
  margin-top: 16rpx;
  color: #0f58a8;
  font-size: 26rpx;
}
.parent-welcome{font-size:40rpx;font-weight:700;line-height:1.55;color:#23334c;word-break:break-all}
.child-name-switch{color:#315ca7;border-bottom:2rpx dashed #9bb4dd;padding-bottom:4rpx;margin-right:8rpx}
.child-caption{margin-top:10rpx;color:#7b8798;font-size:25rpx;line-height:1.6}
.home-child-picker{margin-top:22rpx;background:#fff;border:1rpx solid #e3eaf4;border-radius:20rpx;padding:8rpx 24rpx;box-shadow:0 10rpx 30rpx rgba(40,60,90,.06)}
.home-child-option{display:flex;align-items:center;justify-content:space-between;padding:25rpx 0;font-size:29rpx;color:#34445b;gap:18rpx}
.home-child-option+.home-child-option{border-top:1rpx solid #f0f3f7}.home-child-option.chosen{color:#315ca7;font-weight:600}.child-option-grade{font-size:24rpx;color:#8893a4;margin-left:20rpx;font-weight:400}.child-option-badge{display:inline-block;background:#df4c58;color:#fff;border-radius:99rpx;min-width:28rpx;padding:0 9rpx;line-height:34rpx;font-size:22rpx;margin-right:18rpx}.home-child-add{border-top:1rpx solid #edf1f6;padding:25rpx 0;color:#315ca7;font-size:27rpx}.child-load-retry{color:#315ca7;font-size:25rpx;margin-top:14rpx}
