.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 48rpx; background: #f2f5fa; color: #202c3e; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: #65758b; font-size: 25rpx; }
.panel { margin-top: 20rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; }
.filters, .existing-fields { display: flex; flex-direction: column; gap: 14rpx; }
.field, .existing-fields input, .existing-fields .card { box-sizing: border-box; min-height: 76rpx; padding: 18rpx 22rpx; border-radius: 12rpx; background: #f2f5fa; font-size: 27rpx; }
.picker { display: flex; justify-content: space-between; gap: 16rpx; }
.primary, .secondary { margin: 0; font-size: 27rpx; border-radius: 12rpx; }
.primary { background: #2157ca; color: #fff; }
.primary[disabled] { background: #e8edf5; color: #78889c; }
.secondary { background: #edf3ff; color: #2157ca; }
.primary::after, .secondary::after { border: 0; }
.section-title { margin: 28rpx 0 0; font-size: 29rpx; font-weight: 600; }
.student-name { font-size: 29rpx; font-weight: 600; }
.student-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.existing-fields { margin-top: 16rpx; }
.empty { color: #65758b; text-align: center; }
.error { margin-top: 16rpx; color: #b5473c; }
.pending { margin-left: 10rpx; color: #755018; background: #fff2d9; border-radius: 8rpx; padding: 4rpx 10rpx; font-size: 22rpx; font-weight: 400; }
.course-filter-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.filter-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pending-entry { margin-top: 16rpx; }
.pending-course { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #edf1f6; }
