.page{min-height:100vh;background:#f4f6fa;padding-bottom:40rpx}

/* ============ 日期条 ============ */
.datebar{display:flex;align-items:center;background:#fff;border-radius:18rpx;margin:20rpx 24rpx 16rpx;padding:14rpx 18rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.nav{width:56rpx;height:56rpx;line-height:52rpx;text-align:center;font-size:40rpx;color:#2b6de5;flex-shrink:0}
.datepicker{flex:1;min-width:0}
.dateval{text-align:center;font-size:30rpx;font-weight:700;color:#1c2530}
.wk{margin-left:10rpx;font-size:22rpx;font-weight:400;color:#8a95a3}
.today{margin-left:8rpx;flex-shrink:0;font-size:23rpx;color:#2b6de5;padding:6rpx 18rpx;border:1rpx solid #cfe0ff;border-radius:999rpx;background:#f4f8ff}

/* ============ 操作提示 ============ */
.hint{display:flex;align-items:flex-start;margin:0 24rpx 16rpx;padding:16rpx 20rpx;border-radius:14rpx;background:#eef4ff;font-size:23rpx;line-height:1.55;color:#2b6de5}
.hint-active{background:#fff4e6;color:#b96a00}
.hint-txt{flex:1;min-width:0}
.hint-cancel{margin-left:16rpx;flex-shrink:0;font-weight:700;text-decoration:underline}

.tip{padding:120rpx 40rpx;text-align:center;font-size:26rpx;color:#8a95a3}

/* ============ 未指定教室 ============ */
.unplaced{margin:0 24rpx 20rpx;background:#fff;border-radius:18rpx;padding:20rpx 0 20rpx 20rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.u-head{display:flex;align-items:baseline;justify-content:space-between;padding-right:20rpx;font-size:27rpx;font-weight:700;color:#1c2530}
.u-tip{margin-left:12rpx;font-size:22rpx;font-weight:400;color:#8a95a3}
.u-scroll{margin-top:16rpx;white-space:nowrap}
.u-list{display:flex}
.u-card{width:220rpx;flex-shrink:0;margin-right:16rpx;padding:14rpx 16rpx;background:#f7f9fc;border:2rpx solid transparent;border-radius:14rpx;box-sizing:border-box}
.u-card.is-sel{background:#eef4ff;border-color:#2b6de5}
.u-slot{font-size:21rpx;color:#2b6de5}
.u-name{margin-top:6rpx;font-size:26rpx;font-weight:700;color:#1c2530;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.u-teacher{margin-top:4rpx;font-size:22rpx;color:#8a95a3;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}

/* ============ 校区表格 ============ */
.campus{margin:0 24rpx 24rpx;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06);overflow:hidden}
.campus-head{display:flex;align-items:baseline;justify-content:space-between;padding:22rpx 24rpx 14rpx}
.campus-name{font-size:30rpx;font-weight:700;color:#1c2530}
.campus-count{font-size:24rpx;color:#8a95a3}

.grid{display:flex;align-items:flex-start}
.time-col{width:108rpx;flex-shrink:0;border-right:1rpx solid #eef1f6}
.th{height:84rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;background:#f7f9fc;font-size:23rpx;color:#6b7684;border-bottom:1rpx solid #eef1f6}
.corner{font-size:22rpx}
.td{height:172rpx;box-sizing:border-box;border-bottom:1rpx solid #f4f6fa}
.time{display:flex;align-items:center;justify-content:center;text-align:center;padding:0 6rpx;font-size:20rpx;line-height:1.35;color:#6b7684}

.rooms-scroll{flex:1;min-width:0}
.rooms{display:flex}
.room-col{width:180rpx;flex-shrink:0;border-right:1rpx solid #f4f6fa}
.room-name{padding:0 8rpx;line-height:1.3;font-weight:700;color:#1c2530;word-break:break-all}

.cell{position:relative;display:flex;flex-direction:column;padding:8rpx;overflow:hidden}
.drop-hint{flex:1;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#2b6de5;background:#f4f8ff;border:2rpx dashed #9dbcff;border-radius:12rpx}

.card{padding:8rpx 10rpx;margin-bottom:6rpx;background:#f2f6fd;border:2rpx solid transparent;border-radius:12rpx;box-sizing:border-box}
.card:last-child{margin-bottom:0}
.card.is-sel{background:#e8f0ff;border-color:#2b6de5;box-shadow:0 0 0 2rpx rgba(43,109,229,.16)}
.c-name{font-size:22rpx;font-weight:700;line-height:30rpx;color:#1c2530;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.c-row{display:flex;align-items:center;justify-content:space-between;margin-top:2rpx}
.c-teacher{flex:1;min-width:0;font-size:20rpx;line-height:26rpx;color:#8a95a3;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.c-flag{margin-left:6rpx;flex-shrink:0;padding:0 6rpx;font-size:18rpx;line-height:24rpx;color:#d98324;background:#fff3e2;border-radius:6rpx}
.more{position:absolute;right:4rpx;bottom:4rpx;padding:0 6rpx;font-size:18rpx;line-height:22rpx;color:#8a95a3;background:rgba(255,255,255,.92);border-radius:6rpx}

.foot{padding:10rpx 40rpx 40rpx;text-align:center;font-size:22rpx;color:#8a95a3}
