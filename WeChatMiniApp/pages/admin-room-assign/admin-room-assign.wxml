<view class="page">
  <!-- 日期条：先选日期，再看这一天两个校区的课表 -->
  <view class="datebar">
    <view class="nav" bindtap="prevDay">‹</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange" class="datepicker">
      <view class="dateval">{{date}}<text class="wk">{{weekday}}</text></view>
    </picker>
    <view class="nav" bindtap="nextDay">›</view>
    <view class="today" bindtap="goToday">今天</view>
  </view>

  <!-- 操作提示 / 已选状态 -->
  <view class="hint {{sel ? 'hint-active' : ''}}">
    <block wx:if="{{sel}}">
      <text class="hint-txt">已选「{{sel.courseClassName}}」· {{sel.timeSlot}}，点目标教室完成调整</text>
      <text class="hint-cancel" catchtap="cancelSel">取消</text>
    </block>
    <block wx:else>
      <text class="hint-txt">点课程卡片选中，再点目标教室即可调整。调整从所选日期起生效，之后这门课都在该教室，直到下次重新分配。</text>
    </block>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <block wx:else>
    <!-- 还没分配教室的课：选中后点任意教室即可落位 -->
    <view wx:if="{{unplaced.length}}" class="unplaced">
      <view class="u-head">未指定教室（{{unplaced.length}}）<text class="u-tip">选中后点目标教室</text></view>
      <scroll-view scroll-x class="u-scroll" enhanced show-scrollbar="{{false}}">
        <view class="u-list" style="width:{{unplacedWidth}}rpx;min-width:100%">
          <view wx:for="{{unplaced}}" wx:key="scheduleId" wx:for-item="u"
                class="u-card {{sel.scheduleId === u.scheduleId ? 'is-sel' : ''}}"
                data-id="{{u.scheduleId}}" data-slot="{{u.timeSlot}}" data-name="{{u.courseClassName}}"
                bindtap="selectCourse">
            <view class="u-slot">{{u.timeSlot}}</view>
            <view class="u-name">{{u.gradeName}}{{u.subjectName}}</view>
            <view class="u-teacher">{{u.campusName}} · {{u.teacherName || '教师未填'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 两个校区各一张表：纵轴时段，横轴教室（可横向滚动） -->
    <view wx:for="{{campuses}}" wx:key="campusName" wx:for-item="cp" class="campus">
      <view class="campus-head">
        <text class="campus-name">{{cp.campusName}}</text>
        <text class="campus-count">{{cp.rooms.length}} 间教室</text>
      </view>

      <view class="grid">
        <view class="time-col">
          <view class="th corner">时段</view>
          <view wx:for="{{slots}}" wx:key="value" wx:for-item="t" class="td time">{{t.value}}</view>
        </view>

        <scroll-view scroll-x class="rooms-scroll" enhanced show-scrollbar="{{false}}">
          <view class="rooms" style="width:{{cp.roomsWidth}}rpx;min-width:100%">
            <view wx:for="{{cp.rooms}}" wx:key="classroomId" wx:for-item="room" class="room-col">
              <view class="th room-name">{{room.classroomName}}</view>

              <view wx:for="{{room.cells}}" wx:key="slot" wx:for-item="cell" class="td cell"
                    data-room="{{room.classroomId}}" data-room-name="{{room.classroomName}}" data-slot="{{cell.slot}}"
                    bindtap="onCellTap">
                <view wx:if="{{sel && !cell.list.length && sel.timeSlot === cell.slot}}" class="drop-hint">放这里</view>
                <view wx:for="{{cell.shown}}" wx:key="scheduleId" wx:for-item="c"
                      class="card {{sel.scheduleId === c.scheduleId ? 'is-sel' : ''}}"
                      data-id="{{c.scheduleId}}" data-slot="{{c.timeSlot}}" data-name="{{c.courseClassName}}"
                      data-room="{{room.classroomId}}" data-room-name="{{room.classroomName}}"
                      catchtap="selectCourse">
                  <view class="c-name">{{c.gradeName}}{{c.subjectName}}</view>
                  <view class="c-row">
                    <view class="c-teacher">{{c.teacherName || '教师未填'}}</view>
                    <view wx:if="{{c.moved}}" class="c-flag">已调</view>
                  </view>
                </view>
                <view wx:if="{{cell.more}}" class="more">+{{cell.more}}</view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{!campuses.length}}" class="tip">这一天没有排课</view>
    <view wx:else class="foot">共 {{courseCount}} 门课 · 只能在同一时段、同一校区内调整</view>
  </block>
</view>
