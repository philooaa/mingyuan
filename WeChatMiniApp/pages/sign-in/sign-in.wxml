<view class="page">
  <view class="header">
    <view class="header-title">学生出勤</view>
    <view class="header-subtitle">选择班级，记录本次出勤</view>
  </view>

  <view class="list" wx:if="{{!showEmpty}}">
    <view class="card" wx:for="{{list}}" wx:key="scheduleId">
      <view class="card-main" data-id="{{item.scheduleId}}" bindtap="openSign">
        <view class="card-top">
          <view class="course">{{item.course || '未命名课程'}}</view>
          <view class="badge {{item.reviewClass}}" wx:if="{{item.reviewText}}">{{item.reviewText}}</view>
        </view>
        <view class="meta">
          <text class="tag" wx:if="{{item.periodName}}">{{item.periodName}}</text>
        </view>
        <view class="ui-time">{{item.timeSlot || '上课时间待配置'}}</view>
        <view class="room" wx:if="{{item.room}}">{{item.room}}</view>
        <view class="footer">
          <text class="sign-date">最近签到：{{item.lastDateText}}</text>
          <text class="count" wx:if="{{item.actualText}}">实到 {{item.actualText}}</text>
        </view>
      </view>
      <view class="card-action" data-id="{{item.scheduleId}}" bindtap="openSign">签到</view>
      <view class="correction" wx:for="{{item.corrections}}" wx:for-item="correction" wx:key="classDate" data-id="{{item.scheduleId}}" data-date="{{correction.classDate}}" bindtap="openSign"><view>{{correction.classDate}} · 审核异常（教务处理中） ›</view><view class="correction-reason">{{correction.reviewReason}}</view></view>
    </view>
  </view>

  <view class="empty" wx:if="{{showEmpty && !loading}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无我的排课</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
