@import "../../styles/education-ui.wxss";
.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 40rpx;
}
.correction { margin:0 24rpx 20rpx; padding:20rpx; border-radius:12rpx; background:#fff3e8; color:#a35b24; font-size:26rpx; }
.correction-reason { margin-top:8rpx; color:#8b7766; line-height:1.5; }

.header {
  padding: 40rpx 32rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1c2530;
}

.header-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a95a3;
}

.list {
  padding: 0 24rpx;
}

.card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(28, 37, 48, 0.06);
}

.card-main {
  flex: 1;
  padding: 24rpx 28rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2530;
  flex: 1;
}

.badge {
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.badge.done {
  background: #e6f7ee;
  color: #18a058;
}

.badge.pending {
  background: #fdf3e3;
  color: #c27a08;
}

.meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tag {
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  color: #4a5568;
  font-size: 22rpx;
}

.room {
  font-size: 24rpx;
  color: #8a95a3;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.sign-date {
  font-size: 24rpx;
  color: #8a95a3;
}

.count {
  font-size: 24rpx;
  color: #c27a08;
  font-weight: 600;
}

.card-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  background: #eef4ff;
  color: #2b6de5;
  font-size: 28rpx;
  font-weight: 600;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8a95a3;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a95a3;
}

/* 教育业务页面：紧凑布局与信息层级 */

.header { padding:28rpx 28rpx 24rpx; }
.header-title { font-size:38rpx; color:#202b3d; }
.header-subtitle { color:#68778c; font-size:24rpx; }
.card { position:relative; flex-direction:column; border:1rpx solid #e8edf4; border-radius:18rpx; box-shadow:none; margin-bottom:16rpx; }
.card-main { padding:24rpx; }
.card-top { align-items:flex-start; gap:12rpx; }
.course { min-width:0; line-height:1.5; font-weight:700; word-break:break-word; }
.meta { margin-top:10rpx; }
.tag { font-size:22rpx; padding:4rpx 12rpx; background:#f1f4f9; border-radius:6rpx; }
.room { font-size:24rpx; line-height:1.6; color:#68778c; }
.footer { border-top:1rpx solid #edf1f6; padding-top:16rpx; margin-top:18rpx; padding-right:130rpx; min-height:40rpx; flex-direction:column; align-items:flex-start; gap:8rpx; }
.sign-date { font-size:23rpx; color:#68778c; line-height:1.5; }
.count { font-size:23rpx; color:#2459d9; }
.card-action { position:absolute; right:24rpx; bottom:20rpx; width:106rpx; height:56rpx; border-radius:10rpx; background:#edf2ff; color:#2459d9; font-size:25rpx; }
