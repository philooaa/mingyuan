<view class="page">
  <view class="hero"><view class="brand"><image class="logo" src="/images/logo.png" mode="aspectFit"/><view class="heading">我的缴费</view></view><view class="muted">课程账单 · 费用明细 · 收据与退费</view><view class="actions"><button class="small" bindtap="receipts">我的收据</button><button class="small" bindtap="refunds">退费记录</button><button class="small" bindtap="coupons">我的券</button></view></view>
  <picker range="{{filters}}" value="{{filterIndex}}" bindchange="filter"><view class="picker">{{filters[filterIndex]}} ▾</view></picker>
  <view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">重新加载</button></view>
  <view class="card" wx:for="{{rows}}" wx:key="enrollmentId" data-id="{{item.enrollmentId}}" bindtap="detail"><view class="row"><view class="title">{{item.courseClassName}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted">{{item.studentName}} · {{item.campusName}}</view><view class="muted number">报名号 {{item.enrollmentCode}}</view><view class="safe" wx:if="{{item.financeMode === 'MOCK'}}">模拟 · 不涉及真实资金</view><view class="amount-grid"><view><view class="muted">核定原价</view><view class="value">{{item.originalText}}</view></view><view><view class="muted">优惠抵扣</view><view class="value">{{item.discountText}}</view></view><view><view class="muted">应付</view><view class="value">{{item.payableText}}</view></view><view><view class="muted">待缴</view><view class="value">{{item.dueText}}</view></view><view><view class="muted">已收 / 已退</view><view class="value">{{item.receivedText}} / {{item.refundedText}}</view></view><view><view class="muted">缴费状态</view><view class="value">{{item.payStatus || '待核实'}}</view></view></view><view class="link">查看账单 ›</view></view>
  <view class="state" wx:if="{{loading}}">正在加载账单…</view><view class="state" wx:if="{{!loading && !error && !rows.length}}">暂无课程账单</view><view class="state" wx:if="{{rows.length && rows.length < total}}">上拉加载更多</view>
</view>
