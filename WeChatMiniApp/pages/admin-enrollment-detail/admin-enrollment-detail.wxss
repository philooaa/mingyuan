@import "../admin-enrollment/admin-enrollment.wxss";

/* 教育业务页面：紧凑布局与信息层级 */

.page > button { margin:24rpx 0 0; border-radius:14rpx; font-size:28rpx; background:#fff1f0; color:#bb3c3c; }
.page > .empty { font-size:24rpx; line-height:1.7; }

.transfer-panel {overflow:visible;}
.transfer-search {display:flex;gap:16rpx;align-items:center;margin:20rpx 0;}
.transfer-search input {flex:1;min-width:0;box-sizing:border-box;height:88rpx;padding:16rpx;border:1rpx solid #dce4ef;border-radius:12rpx;font-size:28rpx;line-height:normal;}
.transfer-search button {flex-shrink:0;margin:0;}
.transfer-choice {padding:22rpx 16rpx;margin:16rpx 0;border:2rpx solid #e5eaf2;border-radius:12rpx;word-break:break-all;}
.transfer-choice.chosen {border-color:#195db2;background:#edf5ff;}
.transfer-reason {box-sizing:border-box;width:100%;height:160rpx;margin:16rpx 0;padding:20rpx;border:1rpx solid #dce4ef;border-radius:12rpx;font-size:28rpx;}
.transfer-button {background:#175ba9;color:#fff;margin-top:20rpx;}
.transfer-error {color:#bc3f35;word-break:break-all;}
