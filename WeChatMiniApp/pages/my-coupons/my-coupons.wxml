<view class="page"><view class="hero"><view class="heading">我的优惠券</view><view class="muted">课程现金抵扣券，每笔收费使用一张。已使用券退费后不会自动退回；不适用于资料商城。</view></view><picker range="{{filters}}" value="{{filterIndex}}" bindchange="filter"><view class="picker">{{filters[filterIndex]}} ▾</view></picker><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">重新加载</button></view><view class="card" wx:for="{{rows}}" wx:key="userCouponId"><view class="row"><view class="title">{{item.couponName}}</view><view class="tag">{{item.statusText}}</view></view><view class="price">{{item.amountText}}</view><view class="muted">{{item.summaryText}} · {{item.scopeText}}</view><view class="muted">{{item.subjectText}}</view><view class="muted">{{item.validFrom}} 至 {{item.validUntil}}</view><view class="muted">{{item.description}}</view><view class="muted number">券号 {{item.couponCode || item.userCouponId}}</view></view><view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:if="{{!loading && !error && !rows.length}}">暂无优惠券</view></view>
