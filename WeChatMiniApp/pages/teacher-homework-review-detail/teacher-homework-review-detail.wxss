page{min-height:100vh;background:#f4f7fb;color:#172033}.page{padding:24rpx}.file{display:flex;align-items:center;margin-top:14rpx}.thumb{width:150rpx;height:150rpx;margin-right:16rpx;border-radius:12rpx;background:#eef2f7}.pdf-chip{padding:14rpx 22rpx;border-radius:12rpx;background:#fdeeee;color:#c0392b;font-size:24rpx}.audio-chip{padding:14rpx 22rpx;border-radius:12rpx;background:#eaf7ee;color:#1b9a68;font-size:24rpx}.media{width:100%;height:340rpx;margin-top:16rpx;border-radius:12rpx;background:#000}.header{padding:24rpx;font-size:38rpx;font-weight:800}.card{margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:20rpx}.title{font-size:30rpx;font-weight:700}.answer-title{font-size:28rpx;line-height:1.5}.meta{margin-top:12rpx;color:#66748a;font-size:24rpx}.file image{display:block;width:100%;height:300rpx;margin-top:16rpx}.card input,.card textarea{width:100%;margin-top:16rpx;padding:18rpx;border:1rpx solid #dce5f2;border-radius:12rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6}.card input{height:88rpx;min-height:88rpx;padding:0 18rpx;line-height:normal}.card textarea{min-height:130rpx}.submit{margin:30rpx 0;background:#1768c2;color:#fff}.upload-btn{margin-top:16rpx;background:#eaf2fd;color:#1768c2;font-size:26rpx}.file-del{margin-left:auto;padding:8rpx 18rpx;color:#c0392b;font-size:24rpx}.edit-tag{margin-left:16rpx;padding:8rpx 18rpx;border-radius:12rpx;background:#fff7e6;color:#b06d0f;font-size:24rpx}.share{margin:20rpx 0 30rpx;background:#1b9a68;color:#fff}.share-cv{position:fixed;left:-9999px;top:0;width:600px;height:800px}