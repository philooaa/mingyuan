<view class="page"><view class="header">批阅作业</view><view class="card"><view class="title">{{item.studentName || '学生'}} · {{item.homeworkTitle || '作业'}}</view><view class="meta">提交时间：{{item.submitTime || '-'}}</view><view class="description">学生说明：<text user-select>{{item.description || '无'}}</text></view><view wx:for="{{item.files}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile" bindlongpress="editImage"/><text wx:if="{{item.isImage}}" class="edit-tag" data-url="{{item.url}}" bindtap="editImage">✎ 标注</text><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile">📄　{{item.showName}}</view></view></view><view class="card" wx:for="{{answers}}" wx:key="answerId"><view class="answer-title">第{{index + 1}}题：{{item.answerText || '未作答'}}</view><view class="file" wx:for="{{item.files}}" wx:key="filePath"><image wx:if="{{item.isImage}}" mode="aspectFit" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile" bindlongpress="editImage"/><text wx:if="{{item.isImage}}" class="edit-tag" data-url="{{item.url}}" bindtap="editImage">✎ 标注</text><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile">📄　{{item.showName}}</view></view><view class="meta">自动得分：{{item.score || 0}}　{{item.teacherComment || ''}}</view></view><view class="card"><button class="upload-btn" bindtap="chooseReviewFile">上传附件（图片/PDF/文档/音频/视频）</button><view wx:for="{{reviewFiles}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile"/><video wx:elif="{{item.isVideo}}" class="media" src="{{item.url}}" object-fit="contain"/><view wx:elif="{{item.isAudio}}" class="audio-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="playAudio">▶ 音频　{{item.showName}}</view><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.showName}}" bindtap="openFile">📄　{{item.showName}}</view><view class="file-del" data-index="{{index}}" bindtap="removeReviewFile">删除</view></view></view><view class="card"><input type="number" placeholder="评分" value="{{score}}" data-field="score" bindinput="input"/><textarea placeholder="评语" auto-height value="{{comment}}" data-field="comment" bindinput="input"/></view><button class="submit" loading="{{saving}}" bindtap="save">提交批阅</button><button class="share" loading="{{sharing}}" bindtap="forwardReview">转发批阅结果</button><canvas type="2d" id="shareCv" class="share-cv"/></view>
