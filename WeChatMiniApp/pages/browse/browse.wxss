page{background:#f4f7fb;color:#18385f}.page{padding:28rpx 24rpx calc(36rpx + env(safe-area-inset-bottom))}.hero{padding:30rpx;background:linear-gradient(135deg,#e8f2ff,#fff);border-radius:24rpx}.logo{width:400rpx;max-width:100%}.heading{font-size:42rpx;font-weight:700;margin:26rpx 0 12rpx}.muted,.meta{font-size:25rpx;line-height:1.7;color:#73839a;overflow-wrap:anywhere}.meta{margin-top:10rpx}.login{margin:24rpx 0 0;color:#155ca7;background:white;font-size:28rpx}.tabs,.search,.filters{display:flex;gap:18rpx;margin:24rpx 0;align-items:center}.tab{flex:1;text-align:center;padding:20rpx;border-radius:14rpx;background:white}.selected{background:#175da9;color:white}.search{padding:12rpx 18rpx;background:white;border-radius:14rpx}.input{flex:1;min-width:0;height:76rpx;line-height:normal;font-size:28rpx}.filters picker{flex:1;padding:18rpx;background:white;border-radius:12rpx}.card{background:white;border-radius:20rpx;margin:20rpx 0;padding:26rpx}.title{font-size:30rpx;font-weight:650;line-height:1.6;overflow-wrap:anywhere}.details{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #e6edf5;line-height:1.9;font-size:27rpx}.primary{margin-top:24rpx;background:#175da9;color:white;font-size:28rpx}.state{padding:38rpx;text-align:center;color:#73839a;font-size:26rpx}.material{display:flex;gap:22rpx}.material>view{flex:1;min-width:0}.cover{width:150rpx;height:180rpx;flex-shrink:0;border-radius:12rpx}.price{color:#a46b25;font-size:30rpx;margin:12rpx 0}.mask{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:20}.sheet{position:fixed;left:0;right:0;bottom:0;max-height:80vh;background:white;border-radius:26rpx 26rpx 0 0;z-index:21}.sheet-inner{padding:28rpx 28rpx calc(38rpx + env(safe-area-inset-bottom))}.text{white-space:pre-wrap;line-height:1.8;font-size:27rpx;margin:20rpx 0}.detail-image{width:100%;display:block}button::after{border:0}

.filters{flex-wrap:nowrap;gap:12rpx}.filters picker{min-width:0;box-sizing:border-box;padding:18rpx 14rpx;font-size:25rpx}.filters picker>view{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
