<view class="page">
 <view class="hero"><image class="logo" src="/images/logo.png" mode="widthFix"/><view class="heading">课程与学习资料</view><view class="muted">了解课程安排，选择适合孩子的学习内容</view><button class="login" bindtap="login">{{loggedIn ? '进入小程序' : '登录 / 注册'}}</button></view>
 <view class="tabs"><view class="tab {{tab==='courses'?'selected':''}}" data-tab="courses" bindtap="chooseTab">课程介绍</view><view class="tab {{tab==='materials'?'selected':''}}" data-tab="materials" bindtap="chooseTab">学习资料</view></view>
 <view class="search"><input class="input" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" placeholder="搜索课程或资料名称"/><button size="mini" bindtap="search">搜索</button></view>
 <view class="filters" wx:if="{{tab==='courses'}}"><picker range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="chooseGrade"><view>{{gradeOptions[gradeIndex]}} ▾</view></picker><picker range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="chooseSubject"><view>{{subjectOptions[subjectIndex]}} ▾</view></picker><picker range="{{termOptions}}" value="{{termIndex}}" bindchange="chooseTerm"><view>{{termOptions[termIndex]}} ▾</view></picker></view>
 <view wx:if="{{loading}}" class="state">正在加载…</view><view wx:if="{{error}}" class="state">{{error}}<button size="mini" bindtap="load">重试</button></view>
 <block wx:if="{{tab==='courses'}}"><view class="card" wx:for="{{visibleCourses}}" wx:key="scheduleId"><view class="title" data-id="{{item.scheduleId}}" bindtap="expandCourse">{{item.courseClassName}}　›</view><view class="muted">{{item.gradeName}} · {{item.subjectName}} · {{item.campusName || '校区待安排'}}</view><view class="meta">{{item.termName}} · {{item.periodName}} · {{item.timeSlot}}</view><view wx:if="{{expandedId===item.scheduleId}}" class="details"><view>{{item.startDate}} 至 {{item.endDate}}</view><view>{{item.startTime}}–{{item.endTime}}</view><view>{{item.lessonCount || '待确定'}} 课次</view><view>{{item.tuitionPrice > 0 ? '课程费用：¥'+item.tuitionPrice : '费用请咨询课程顾问'}}</view><button class="primary" bindtap="enroll">{{loggedIn ? '前往报名' : '登录后报名'}}</button></view></view><view class="state" wx:if="{{!loading && !error && !visibleCourses.length}}">暂无符合条件的课程</view></block>
 <block wx:else><view class="card material" wx:for="{{materials}}" wx:key="materialId" data-id="{{item.materialId}}" bindtap="expandMaterial"><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill"/><view><view class="title">{{item.title}}　›</view><view class="muted">{{item.subtitle}}</view><view class="meta">{{item.gradeName}} · {{item.subjectName}} · {{item.deliveryText}}</view><view class="price">{{item.priceText}}</view></view></view><view class="state" wx:if="{{!loading && !error && !materials.length}}">暂无上架资料</view></block>
 <view class="mask" wx:if="{{materialDetail}}" bindtap="closeDetail"></view><scroll-view class="sheet" scroll-y wx:if="{{materialDetail}}"><view class="sheet-inner"><button size="mini" bindtap="closeDetail">关闭</button><view class="title">{{materialDetail.title}}</view><view class="price">{{materialDetail.priceText}}</view><view class="text">{{materialDetail.intro}}</view><image class="detail-image" wx:for="{{materialDetail.gallery}}" wx:key="imageUrl" src="{{item.imageUrl}}" mode="widthFix"/><view class="text">{{materialDetail.detailText}}</view><image class="detail-image" wx:for="{{materialDetail.detailImages}}" wx:key="imageUrl" src="{{item.imageUrl}}" mode="widthFix"/><button class="primary" bindtap="buy">{{loggedIn ? '前往购买' : '登录后购买'}}</button></view></scroll-view>
</view>
