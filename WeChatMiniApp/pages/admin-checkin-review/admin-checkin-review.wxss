.page{min-height:100vh;background:#f4f6fa;padding-bottom:40rpx}
.top-bar{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 12rpx}
.date-pick{font-size:30rpx;font-weight:600;color:#1c2530}
.count-text{font-size:26rpx;color:#8a95a3}
.tip{padding:120rpx 0;text-align:center;font-size:26rpx;color:#8a95a3}
.groups{padding:0 24rpx}
.section{margin-bottom:24rpx}
.section-head{display:flex;align-items:baseline;justify-content:space-between;padding:16rpx 8rpx}
.section-title{font-size:30rpx;font-weight:700;color:#1c2530}
.section-title.ok{color:#1c8a4c}
.section-title.miss{color:#d94c4c}
.section-empty{background:#fff;border-radius:18rpx;padding:24rpx;text-align:center;font-size:26rpx;color:#b6bfca;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.room.missing{border-left:8rpx solid #d94c4c}
.room-sub.warn{color:#d94c4c}
.room{display:flex;align-items:center;justify-content:space-between;background:#fff;border-radius:18rpx;padding:22rpx 26rpx;margin-bottom:14rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.room-main{flex:1;min-width:0}
.room-name{font-size:30rpx;font-weight:600;color:#1c2530}
.room-tag{margin-left:16rpx;font-size:22rpx;font-weight:400;color:#2b6de5;background:#eaf1fd;border-radius:8rpx;padding:2rpx 12rpx}
.room-sub{margin-top:8rpx;font-size:24rpx;color:#8a95a3}
.room-ops{display:flex;gap:24rpx;flex-shrink:0}
.op{font-size:26rpx;color:#2b6de5}
.op.del{color:#d94c4c}
.add-entry{margin:24rpx 24rpx 0;background:#2b6de5;color:#fff;border-radius:16rpx;font-size:30rpx}
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;z-index:99}
.sheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx;box-sizing:border-box;max-height:80vh;overflow-y:auto}
.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.sheet-title{font-size:34rpx;font-weight:700;color:#1c2530}
.sheet-close{font-size:26rpx;color:#8a95a3}
.form-item{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f0f2f6}
.form-label{width:180rpx;font-size:28rpx;color:#4a5568;flex-shrink:0}
.form-input{flex:1;font-size:28rpx;color:#1c2530}
.form-picker{flex:1}
.picker-val{font-size:28rpx;color:#1c2530}
.picker-val.ph{color:#b6bfca}
.btn-primary{margin-top:32rpx;background:#2b6de5;color:#fff;border-radius:16rpx;font-size:30rpx}
.tabs{display:flex;margin:24rpx 24rpx 0;background:#fff;border-radius:16rpx;padding:8rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.tab{flex:1;text-align:center;padding:16rpx 0;font-size:28rpx;color:#4a5568;border-radius:12rpx}
.tab.on{background:#2b6de5;color:#fff;font-weight:600}
.punch-line{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;margin-top:12rpx}
.pl-label{font-size:24rpx;color:#8a95a3;width:72rpx;flex-shrink:0}
.pl-time{font-size:26rpx;color:#1c8a4c;font-weight:600}
.pl-time.none{color:#d94c4c;font-weight:400}
.pl-meta{font-size:22rpx;color:#8a95a3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.op.add{color:#1c8a4c}
.st{margin-left:16rpx;font-size:22rpx;border-radius:8rpx;padding:2rpx 12rpx}
.st-ok{color:#1c8a4c;background:#e6f7ee}
.st-miss{color:#d94c4c;background:#fdeeee}
.st-part{color:#d98a1f;background:#fff7e6}
.stats-table{margin:24rpx;background:#fff;border-radius:18rpx;overflow:hidden;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.tr{display:flex;padding:20rpx 16rpx;border-bottom:1rpx solid #f0f2f6}
.tr.th{background:#f7f9fc;font-size:24rpx;color:#8a95a3}
.tr.total{background:#f7f9fc;font-weight:600}
.td{font-size:26rpx;color:#1c2530}
.tname{width:180rpx}
.tnum{flex:1;text-align:center}
.tnum.warn{color:#d94c4c}
.tr-link:active{background:#f0f5ff}
.tnum.arrow{color:#2b6de5;font-size:34rpx;line-height:26rpx}
.stats-hint{padding:16rpx;text-align:center;font-size:22rpx;color:#b6bfca}
.detail-day{padding:16rpx 0;border-bottom:1rpx solid #f0f2f6}
.detail-date{display:flex;align-items:center;font-size:28rpx;font-weight:600;color:#1c2530;margin-bottom:8rpx}
.detail-line{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;margin-top:8rpx}
