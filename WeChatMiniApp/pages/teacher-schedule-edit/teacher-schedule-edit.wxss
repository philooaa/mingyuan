@import "../../styles/education-ui.wxss";
page { background: #f4f7fb; color: #172033; }
.page { padding: 28rpx 24rpx 60rpx; }
.title { font-size: 38rpx; font-weight: 800; color: #0b326a; margin-bottom: 20rpx; }
.note { font-size: 24rpx; line-height: 1.7; color: #6e7a8c; padding: 12rpx 0 20rpx; }
.field { background: white; padding: 20rpx; border-radius: 12rpx; margin-bottom: 14rpx; font-size: 27rpx; }
.field > view:first-child { color: #647286; font-size: 24rpx; margin-bottom: 12rpx; }
.field input, .picker, .value { min-height: 52rpx; line-height: 52rpx; }
.value { word-break: break-all; color: #647286; }
.field textarea { width: 100%; height: 160rpx; }
.save { background: #0f58a8; color: white; margin: 24rpx 0; }
.delete { background: #fff2f2; color: #b33636; }
.message { padding: 30rpx; background: white; border-radius: 12rpx; }
.error { color: #b33636; }

/* 教育业务页面：紧凑布局与信息层级 */

.page { padding-top:28rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.title { font-size:38rpx; color:#202b3d; font-weight:700; margin-bottom:4rpx; }
.note { color:#68778c; font-size:24rpx; padding:6rpx 0 20rpx; line-height:1.65; }
.teacher-profile { display:flex; justify-content:space-between; align-items:center; gap:16rpx; background:#edf2ff; padding:20rpx 24rpx; margin-bottom:20rpx; border-radius:12rpx; font-size:26rpx; color:#2459d9; }
.field { border:1rpx solid #e8edf4; border-radius:14rpx; padding:20rpx 24rpx; margin-bottom:12rpx; }
.field > view:first-child { font-size:24rpx; color:#52627a; margin-bottom:6rpx; }
.field input,.picker { font-size:28rpx; color:#202b3d; min-height:60rpx; line-height:60rpx; }
.field .note { padding-bottom:0; margin-top:6rpx; }
.save { background:#2459d9; border-radius:14rpx; font-size:28rpx; font-weight:600; min-height:88rpx; line-height:88rpx; }
.delete { border-radius:14rpx; font-size:26rpx; background:#fff1f0; }
