<view class="page">
  <view class="header">
    <view class="title">{{teacherMode ? '我的课程' : '我的课表'}}</view>
    <view class="ui-caption">上课安排与学员报名记录</view>
  </view>

  <view class="summary" wx:if="{{!teacherMode}}">
    <view class="summary-item">
      <view class="summary-value">{{loadSucceeded && !loading && !loadError ? timetableCount : '—'}}</view>
      <view class="summary-label">已报名课次</view>
    </view>
    <button wx:if="{{!teacherMode}}" class="summary-btn" bindtap="goEnrollment">继续报名</button>
  </view>

  <view class="load-status" wx:if="{{loading}}">正在加载课表…</view>
  <view class="calendar-warning load-error" wx:if="{{loadError && !loading}}">
    <view>{{loadError}}</view>
    <button size="mini" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{teacherMode}}">
    <view class="empty"><view class="empty-title">教师课表已合并至“我的课程”</view><button class="primary-btn" bindtap="redirectTeacher">进入我的课程</button></view>
  </view>
  <view class="empty" wx:if="{{loadSucceeded && !loading && !loadError && showEmpty && !teacherMode}}">
    <view class="empty-title">暂无课表</view>
    <button wx:if="{{!teacherMode}}" class="primary-btn" bindtap="goEnrollment">去报名</button>
  </view>

  <view class="period" wx:if="{{loadSucceeded && !loading && !loadError && !teacherMode}}" wx:for="{{groupedTimetable}}" wx:key="key">
    <view class="period-title">{{item.key}}</view>
    <view class="course-card" wx:for="{{item.items}}" wx:for-item="course" wx:key="viewKey">
      <view class="next-class" wx:if="{{course.nextClassDate}}">
        <text class="next-label">下一次课</text>
        <text class="next-date">{{course.nextClassDate}}</text>
        <text class="next-weekday">{{course.nextClassWeekday}}</text>
      </view>
      <view class="next-class ended" wx:elif="{{course.nextClassEnded}}">
        <text class="next-label">本期已结课</text>
      </view>
      <view class="next-class pending" wx:else>
        <text class="next-label">排课日期待配置</text>
      </view>
      <view class="time-pill">{{course.timeText}}</view>
      <view class="course-main">
        <view class="course-name">{{course.courseClassName}}</view>
        <view class="course-meta">{{course.subjectTag}} · {{course.teacherName}}</view>
        <view class="course-meta">{{course.placeText}}</view>
        <view class="course-footer" wx:if="{{!teacherMode}}">
          <view class="student">学生：{{course.studentName}}</view>
          <view class="cancel-pending-label" wx:if="{{course.cancelRequestPending}}">取消待处理</view>
          <view class="cancel-btn" wx:elif="{{course.canCancel}}"
                catchtap="handleCancel"
                data-enrollment-id="{{course.enrollmentId}}">{{cancelingId === course.viewKey ? '处理中…' : (course.classDate ? '申请取消' : '取消')}}</view>
        </view>
      </view>
      <view class="pay-tag {{course.payStage}}" wx:if="{{!teacherMode}}">{{course.payText}}</view>
    </view>
  </view>
  <view class="advisor-card" wx:if="{{!teacherMode}}">
    <view class="advisor-title">报名及缴费提醒</view>
    <view class="advisor-notice">提交报名后，课程顾问将在24小时内联系您，确认课程安排、缴费及相关事项。您也可以主动添加课程顾问咨询。</view>
    <view class="advisor-wechat-row">
      <text class="advisor-wechat" selectable="{{true}}">顾问微信：{{advisorWechat}}</text>
      <button class="advisor-copy" bindtap="copyAdvisorWechat">复制微信号</button>
    </view>
    <image class="advisor-qr" src="{{advisorQrImage}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewAdvisorQr" />
    <view class="advisor-hint">点击二维码查看大图，可保存后使用微信扫一扫添加；也可搜索上方微信号添加。</view>
  </view>
</view>
