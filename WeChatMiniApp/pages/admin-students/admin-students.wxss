.page{min-height:100vh;background:#f4f6fa;padding-bottom:40rpx}
.search-bar{padding:24rpx 32rpx 12rpx}
.search-input{height:72rpx;background:#fff;border-radius:999rpx;padding:0 32rpx;font-size:28rpx}
.filter-tabs{display:flex;gap:16rpx;padding:8rpx 32rpx 4rpx}
.tab{padding:8rpx 28rpx;border-radius:999rpx;background:#fff;color:#4a5568;font-size:26rpx}
.tab-active{background:#2b6de5;color:#fff;font-weight:600}
.count-bar{padding:12rpx 32rpx 4rpx;font-size:24rpx;color:#8a95a3}
.tip{padding:120rpx 0;text-align:center;font-size:26rpx;color:#8a95a3}
.list{padding:0 24rpx}
.row{background:#fff;border-radius:20rpx;padding:24rpx 28rpx;margin-bottom:18rpx;box-shadow:0 4rpx 16rpx rgba(28,37,48,.06)}
.row-head{display:flex;align-items:center;justify-content:space-between}
.row-name{font-size:32rpx;font-weight:700;color:#1c2530}
.badge{padding:4rpx 16rpx;border-radius:999rpx;font-size:22rpx}
.badge.ok{background:#e6f7ee;color:#18a058}
.badge.gray{background:#eef2f8;color:#4a5568}
.row-sub{margin-top:10rpx;font-size:24rpx;color:#8a95a3}
.more-tip{padding:24rpx 0;text-align:center;font-size:24rpx;color:#a3adba}
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;z-index:99}
.sheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx;box-sizing:border-box;max-height:82vh;overflow-y:auto}
.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.sheet-title{font-size:34rpx;font-weight:700;color:#1c2530}
.sheet-close{font-size:26rpx;color:#8a95a3}
.info{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #f0f2f6;font-size:28rpx}
.info-k{color:#8a95a3}
.info-v{color:#1c2530;font-weight:600;text-align:right;max-width:60%}
.section-title{margin:28rpx 0 12rpx;font-size:28rpx;font-weight:700;color:#1c2530}
.course{background:#f7f9fc;border-radius:16rpx;padding:20rpx 22rpx;margin-bottom:14rpx}
.course-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.course-name{font-size:28rpx;font-weight:600;color:#1c2530;flex:1;word-break:break-all}
.course-sub{margin-top:8rpx;font-size:23rpx;color:#8a95a3}
