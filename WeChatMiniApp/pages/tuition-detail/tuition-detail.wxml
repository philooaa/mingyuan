<view class="page">
  <view class="state" wx:if="{{loading}}">正在核对最新账单…</view><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新状态</button></view>
  <block wx:if="{{detail}}">
    <view class="hero"><view class="heading">{{detail.courseClassName}}</view><view class="muted">{{detail.studentName}} · {{detail.campusName}}</view><view class="muted number">{{detail.enrollmentCode}}</view><view class="tag">{{detail.statusText}} · {{detail.payStatus || '待核实'}}</view></view>
    <view class="safe" wx:if="{{detail.financeMode === 'MOCK'}}">模拟账单 · 不涉及真实资金</view>
    <view class="card" wx:if="{{detail.billType === 'CREDIT_PACKAGE' && detail.packageSnapshot}}"><view class="title">一对一课包购买明细</view><view class="muted">购买年级 {{detail.packageSnapshot.gradeName}} · {{detail.packageSnapshot.packageCount}} 包 · {{detail.packageSnapshot.credits}} 个基础额度</view><view class="muted">基础单价 ¥{{detail.packageSnapshot.unitPrice}} · 原价 ¥{{detail.packageSnapshot.grossAmount}}</view><view class="muted">课包优惠 ¥{{detail.packageSnapshot.packageDiscount}} · 折后 ¥{{detail.packageSnapshot.subtotal}}</view><view class="muted">优惠券抵扣 ¥{{detail.packageSnapshot.couponDiscount}}</view><view class="value">最终应付 ¥{{detail.packageSnapshot.payableAmount}}</view><view class="muted">{{detail.packageCreditedTime?'额度已入账：'+detail.packageCreditedTime:detail.billingStatus==='CLOSED'?'订单已取消':'待确认收款，确认后一次性增加孩子额度'}}</view><view class="muted">每次固定2小时，精英扣1、资深扣2个额度。课包余额暂不支持班课退费申请，请联系教务咨询。</view></view>
    <view class="notice" wx:if="{{detail.billingStatus === 'HISTORY_PENDING'}}">历史费用待财务凭证核验。未知金额不是0元，也不代表欠费；请联系校区财务。</view><view class="notice" wx:if="{{detail.billingStatus === 'PENDING_PRICE'}}">课程费用尚未核定，请等待财务核价。</view>
    <view class="card"><view class="title">费用明细</view><view class="amount-grid"><view><view class="muted">核定原价</view><view class="value">{{detail.originalText}}</view></view><view><view class="muted">优惠抵扣</view><view class="value">{{detail.discountText}}</view></view><view><view class="muted">应付</view><view class="value">{{detail.payableText}}</view></view><view><view class="muted">待缴</view><view class="value">{{detail.dueText}}</view></view><view><view class="muted">实际已收</view><view class="value">{{detail.receivedText}}</view></view><view><view class="muted">已退</view><view class="value">{{detail.refundedText}}</view></view><view><view class="muted">净收款</view><view class="value">{{detail.netText}}</view></view></view><view class="muted">退款不会产生新的欠费，优惠抵扣不属于可退现金。</view></view>
    <view class="notice">课程费用请联系教务线下缴纳。教务登记并确认实际收款后，本页更新账单与收据。</view>
    <view class="notice" wx:if="{{detail.activePayment || paymentUncertain}}">已有待核对付款或历史请求结果未知，请联系教务核对，避免重复缴费。</view>
    <view class="card" wx:if="{{coupons.length}}"><view class="title">账单优惠券</view><view class="muted" wx:for="{{coupons}}" wx:key="userCouponId">{{item.couponName}}：{{item.amountText}}，{{item.statusText}}；{{item.validFrom}} 至 {{item.validUntil}}</view></view>
    <view class="card"><view class="title">付款记录</view><view class="timeline" wx:for="{{detail.payments}}" wx:key="paymentId"><view class="row"><view>{{item.statusText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.paymentNo}}</view><view class="muted">{{item.channelText}} · {{item.paidTime || item.createTime}}</view><view class="muted">{{item.failureReason}}</view></view><view class="muted" wx:if="{{!detail.payments.length}}">暂无缴费记录</view></view>
    <view class="actions"><button bindtap="receipts">收据 / 减免单</button><button wx:if="{{detail.billType !== 'CREDIT_PACKAGE'}}" bindtap="refunds">{{detail.canRefund ? '申请退费' : '退费记录'}}</button></view><button class="small" wx:if="{{detail.canCancel && !paymentUncertain}}" bindtap="cancelEnrollment" disabled="{{submitting || loading}}">{{detail.billType==='CREDIT_PACKAGE'?'取消未收款课包订单':'取消未缴费报名'}}</button><view class="card" wx:if="{{detail.refunds.length}}"><view class="title">退费进度</view><view class="timeline" wx:for="{{detail.refunds}}" wx:key="refundId"><view class="row"><view>{{item.kindText}}</view><view>{{item.statusText}}</view></view><view class="muted" wx:if="{{item.refundStatus === 'SUCCESS'}}">实际退款 {{item.approvedText}}</view><view class="muted">{{item.progressText || item.workflowText}}</view><view class="muted">{{item.reason}}</view></view></view>
  </block>
</view>
