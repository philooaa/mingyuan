<view class="page">
  <view class="hero"><view class="heading">课程退费</view><view class="muted">教务确认金额 → 管理员登记线下实际退款 → 已退款。成功后显示最终金额。</view></view>
  <view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新</button></view>
  <view class="card" wx:if="{{detail}}">
    <view class="title">{{detail.courseClassName}} · {{detail.studentName}}</view><view class="row"><view>实际已收</view><view>{{detail.receivedText}}</view></view><view class="row"><view>已退</view><view>{{detail.refundedText}}</view></view>
    <view class="notice" wx:if="{{!detail.canRefund && !retrying}}">当前不能申请退费，或已有申请正在处理。零元减免退出课程请联系教务。</view>
    <view class="notice" wx:if="{{legacyIntent}}">历史申请结果尚未确定，请联系教务核对原申请；原请求标识已保留。</view>
    <block wx:if="{{(detail.canRefund || retrying) && !legacyIntent}}">
      <view class="notice" wx:if="{{retrying}}">上次申请结果未确定，请重试原申请；范围、对象及原因已保留。</view>
      <view class="label">退费范围</view><picker range="{{kindOptions}}" value="{{kindIndex}}" disabled="{{submitting || retrying}}" bindchange="kind"><view class="picker">{{kindOptions[kindIndex]}} ▾</view></picker>
      <block wx:if="{{kindIndex === 2 && !retrying}}"><view class="label">选择单次请假／返次记录</view><view class="muted" wx:if="{{targetsLoading}}">正在查询可申请课次…</view><view class="state error" wx:if="{{targetError}}">{{targetError}}<button class="small" bindtap="loadTargets">重新查询</button></view><picker wx:if="{{targets.length}}" range="{{targetOptions}}" value="{{targetIndex}}" disabled="{{submitting || targetsLoading}}" bindchange="target"><view class="picker">{{targetOptions[targetIndex]}} ▾</view></picker><view class="notice">已取消预约的返还次数会在申请期间预留，退款成功后收回，避免同一次课重复退次和退钱。</view></block>
      <view class="label">退费原因</view><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{submitting || retrying}}" placeholder="说明退费原因"/>
      <button class="primary" bindtap="apply" loading="{{submitting}}" disabled="{{submitting || loading || targetsLoading || (kindIndex === 2 && !retrying && (!targets.length || targetError))}}">{{retrying ? '重试原申请' : '提交退费申请'}}</button>
    </block>
  </view>
  <view class="section-title">退费记录</view><view class="card" wx:for="{{rows}}" wx:key="refundId">
    <view class="row"><view class="title">{{item.kindText}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted number">{{item.refundNo}}</view>
    <view class="row" wx:if="{{item.refundStatus === 'SUCCESS'}}"><view>实际退款金额</view><view>{{item.approvedText}}</view></view>
    <view class="muted">{{item.progressText || item.workflowText}}</view><view class="muted">原因：{{item.reason}}</view><view class="muted" wx:if="{{item.reviewRemark}}">审核说明：{{item.reviewRemark}}</view><view class="muted">完成时间：{{item.completedTime || '尚未完成'}}</view><view class="muted">{{item.failureReason}}</view>
    <view class="safe" wx:if="{{item.financeMode === 'MOCK'}}">模拟 · 不涉及真实资金</view>
  </view>
  <view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:if="{{!loading && !error && !rows.length}}">暂无退费记录</view>
</view>
