:host{display:block}
.makeup-panel{margin:32rpx 24rpx;color:#253750}
.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:20rpx;margin:0 4rpx 20rpx}
.panel-heading-main{min-width:0}.panel-title{font-size:31rpx;font-weight:600;letter-spacing:1rpx}.panel-caption{margin-top:8rpx;color:#8996a9;font-size:24rpx;line-height:1.5;overflow-wrap:break-word}.panel-count{flex-shrink:0;color:#8291a5;font-size:23rpx}
.record{margin-bottom:20rpx;padding:28rpx;border:1rpx solid #e6edf5;border-radius:24rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(31,55,91,.025)}
.record-top,.target-heading,.history-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.lecture-tag{font-size:23rpx;color:#71849d;line-height:1.5}.badge{display:flex;align-items:center;gap:8rpx;flex-shrink:0;padding:8rpx 16rpx;border-radius:100rpx;font-size:22rpx;line-height:1.4;color:#a87725;background:#fff5e2}.status-dot{width:8rpx;height:8rpx;flex-shrink:0;border-radius:50%;background:currentColor}.badge.scheduled{color:#3669ad;background:#edf4ff}.badge.completed{color:#27855f;background:#eaf7ef}.badge.conflict{color:#927042;background:#f8f3e9}
.course-name{margin-top:18rpx;font-size:30rpx;font-weight:600;line-height:1.5;overflow-wrap:break-word}.original{display:flex;gap:16rpx;margin-top:12rpx;color:#7d8ba0;font-size:24rpx;line-height:1.6}.original-label{color:#a0adbd}
.target{margin-top:24rpx;padding:24rpx;background:#f4f7fd;border:1rpx solid #eaf0fa;border-radius:18rpx}.target-label{color:#6d86aa;font-size:23rpx}.target-lecture{color:#879ab7;font-size:22rpx}.target-date{margin-top:18rpx;color:#2a548b;font-size:37rpx;font-weight:600;letter-spacing:1rpx;line-height:1.3}.target-time{margin-top:8rpx;font-size:28rpx;color:#3d6497;font-weight:500}.target-course{margin:22rpx 0 18rpx;padding-top:18rpx;border-top:1rpx solid #e2eaf6;color:#4b6381;font-size:25rpx;line-height:1.55;overflow-wrap:break-word}.target-meta{display:flex;align-items:flex-start;gap:16rpx;margin-top:9rpx;font-size:24rpx;color:#61758f;line-height:1.6}.meta-label{flex-shrink:0;color:#95a3b6}.place-text{min-width:0;overflow-wrap:break-word}.target-completed{background:#f5faf7;border-color:#e6f1eb}.target-completed .target-date{color:#34755b}.target-completed .target-course{border-color:#e4eee8}
.status-hint{margin-top:20rpx;font-size:24rpx;color:#8a98aa;line-height:1.7}.status-hint.completed{color:#5d8a73}.status-hint.failed{color:#a18758}
.history{margin-top:22rpx;border-top:1rpx solid #eef2f7}.history-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;margin:0;padding:22rpx 0 0;border:0;border-radius:0;background:transparent;color:#657b98;text-align:left;font-size:24rpx;line-height:1.6;min-height:66rpx}.history-toggle::after,.retry::after{border:0}.history-count{margin-left:12rpx;color:#a2afbf;font-size:22rpx}.history-chevron{color:#9aabc1;font-size:22rpx}.history-list{padding:22rpx 0 0 10rpx}.history-row{position:relative;display:flex;gap:20rpx;padding-bottom:24rpx}.history-row:last-child{padding-bottom:0}.history-row:not(:last-child)::before{content:'';position:absolute;left:5rpx;top:18rpx;bottom:0;width:1rpx;background:#e5ecf5}.history-dot{width:12rpx;height:12rpx;margin-top:9rpx;flex-shrink:0;border-radius:50%;background:#7799c9}.history-dot.cancelled{background:#c8d1de}.history-content{flex:1;min-width:0}.history-top{font-size:24rpx;color:#6b7d96}.history-state{font-size:22rpx;color:#7894b6}.history-state.cancelled{color:#a5afbd}.history-time{margin-top:5rpx;color:#8291a6;font-size:23rpx}.history-course{margin-top:7rpx;color:#99a6b7;font-size:23rpx;line-height:1.6;overflow-wrap:break-word}
.empty-card,.error-card,.loading-card{padding:36rpx 28rpx;border:1rpx solid #e6edf5;border-radius:22rpx;background:#fff;text-align:center}.empty-mark{width:68rpx;height:68rpx;margin:0 auto 18rpx;border-radius:22rpx;line-height:68rpx;background:#f2f6fc;color:#b0bfd2;font-size:32rpx}.message-title{font-size:26rpx;font-weight:500;color:#708099}.message-caption{margin-top:12rpx;color:#9ba8ba;font-size:23rpx;line-height:1.7}.retry{display:inline-block;margin:24rpx 0 0;padding:12rpx 28rpx;border-radius:12rpx;background:#edf4ff;color:#3f6fae;font-size:24rpx;line-height:1.6}.skeleton{border-radius:10rpx;background:#f1f5fa}.skeleton-title{width:65%;height:26rpx}.skeleton-line{width:38%;height:18rpx;margin-top:18rpx}.skeleton-block{height:140rpx;margin-top:28rpx;border-radius:16rpx}.loading-label{margin-top:22rpx;color:#a2afbf;font-size:23rpx}
