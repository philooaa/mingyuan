<import src="personal-account.wxml" />
<template name="child-account">
<view class="child-page">
  <view class="error-box" wx:if="{{error}}">{{error}}<button size="mini" bindtap="load">重新加载</button></view>
  <block wx:if="{{view==='list' && !legacy}}">
    <view class="page-heading"><view><view class="page-title">我的账户</view><view class="subtle">选择孩子，管理课程与学习</view></view><view class="total-badge" wx:if="{{pendingBadge}}">{{pendingBadge}} 项待办</view></view>
    <view class="child-card" wx:for="{{accounts}}" wx:key="accountId" data-id="{{item.accountId}}" bindtap="openChild" hover-class="card-pressed">
      <text class="corner-badge" wx:if="{{item.pendingBadge}}">{{item.pendingBadge}}</text>
      <view class="child-top"><view class="avatar">{{item.initial}}</view><view class="grow"><view class="child-name">{{item.studentName}}</view><view class="grade">{{item.gradeName || '年级待完善'}}</view></view><text class="arrow">›</text></view>
      <view class="child-metrics"><view><text class="metric-number">{{item.availableText}}</text><text class="metric-label">可用额度</text></view><view><text class="metric-number secondary">{{item.courseCount}}</text><text class="metric-label">已报课程</text></view></view>
      <view class="child-todos" wx:if="{{item.pendingBadge}}"><text wx:if="{{item.paymentPendingCount}}">待缴费 {{item.paymentPendingCount}}</text><text wx:if="{{item.homeworkPendingCount}}">待交作业 {{item.homeworkPendingCount}}</text></view>
    </view>
    <view class="empty-box" wx:if="{{!loading && !error && !accounts.length}}"><view class="empty-symbol">＋</view><view class="empty-title">添加第一位孩子</view><view class="subtle">课程、学习记录和课包会集中在孩子页面</view></view>
    <button class="primary add-child" bindtap="openCreate" disabled="{{loading || submitting || !detail}}">＋ 添加孩子信息</button>
    <view class="secondary-entry" wx:if="{{unlinkedCount}}" bindtap="openLegacy"><view><view class="entry-title">未关联历史记录 <text class="small-badge" wx:if="{{unlinkedPendingBadge}}">{{unlinkedPendingBadge}}</text></view><view class="subtle">{{unlinkedCount}} 条记录 · 联系管理员核对归属</view></view><text class="arrow">›</text></view>
    <view class="section-heading">家长服务</view><view class="parent-services"><view data-key="orders" bindtap="openService">商城订单</view><view data-key="coupons" bindtap="openService">优惠券</view><view data-key="referral" bindtap="openService">邀请好友</view></view>
  </block>
  <block wx:elif="{{legacy}}"><view class="page-heading"><view><view class="page-title">未关联历史记录</view><view class="subtle">保留原记录，管理员核对后再关联孩子</view></view></view>
    <view class="course-card" wx:for="{{records}}" wx:key="recordKey"><view class="card-heading">{{item.studentName}}<text class="status-pill">{{item.progressText}}</text></view><view>{{item.courseClassName}}</view><view class="subtle">{{item.statusText}} · {{item.timeText}}</view><button class="text-button" wx:if="{{item.settlementMethod!=='P'}}" data-id="{{item.enrollmentId}}" bindtap="openFinance">查看缴费详情 ›</button></view>
  </block>
  <block wx:elif="{{child}}">
    <view class="profile-hero"><view class="child-top"><view class="avatar large">{{child.initial}}</view><view class="grow"><view class="detail-name">{{child.studentName}}</view><view class="grade">{{child.gradeName}}</view></view><view class="edit-link" bindtap="editProfile">编辑资料</view></view><view class="hero-metrics"><view><view class="hero-number">{{child.availableText}}<text> 额度</text></view><view class="subtle">可用＝剩余－预约暂占</view></view><view><view class="hero-number secondary">{{child.courseCount}}</view><view class="subtle">已报课程</view></view></view></view>
    <view class="section-heading" wx:if="{{child.pendingBadge}}">待办事项 <text class="small-badge">{{child.pendingBadge}}</text></view>
    <view class="todo-panel" wx:if="{{child.pendingBadge}}"><view class="todo-row" wx:if="{{child.paymentPendingCount}}"><view><view class="entry-title">{{child.paymentPendingCount}} 笔待缴费</view><view class="subtle">请联系教务线下缴纳</view></view><button size="mini" class="todo-button" bindtap="handlePayment">查看账单</button></view><view class="todo-row" wx:if="{{child.homeworkPendingCount}}"><view><view class="entry-title">{{child.homeworkPendingCount}} 份作业待提交</view><view class="subtle">待完成的有效作业</view></view><button size="mini" class="todo-button" data-todo="1" bindtap="homework">去提交</button></view></view>
    <view class="detail-tabs"><view wx:for="{{sections}}" wx:key="key" class="{{section===item.key?'selected':''}}" data-section="{{item.key}}" bindtap="section">{{item.name}}</view></view>
    <view class="section-actions" wx:if="{{section==='courses'}}"><button class="primary" size="mini" bindtap="enroll">报名课程</button><button size="mini" bindtap="timetable">查看课表 ›</button></view>
    <block wx:if="{{section==='fees'}}"><view class="credit-panel"><view class="section-heading">课包额度</view><view class="credit-breakdown"><view><text class="credit-number">{{child.remainingCredits}}</text><text>剩余额度</text></view><view><text class="credit-number">{{child.reservedCredits}}</text><text>预约暂占</text></view><view><text class="credit-number">{{child.consumedCredits}}</text><text>已消耗</text></view></view><view class="credit-note">每次一对一为 2 小时。精英教师每次扣 1 个额度，资深教师每次扣 2 个额度。预约先暂占，完成后正式扣除；额度不等于可上课节数。</view><view class="text-link" bindtap="creditHistory">查看额度流水 ›</view></view><view class="section-actions"><view class="entry-title">{{recordKind==='history'?'交易流水':pendingOnly?'待缴费记录':'课程费用'}}</view><view class="text-link" bindtap="transactions">{{recordKind==='history'?'查看课程费用':'查看交易流水'}} ›</view></view><view class="text-link" wx:if="{{pendingOnly}}" bindtap="allPayments">查看全部费用记录</view></block>
    <button wx:if="{{section==='fees'}}" class="text-button" bindtap="purchasePackage" disabled="{{loading}}">购买一对一课包 ›</button>
    <block wx:if="{{section==='learning'}}"><view class="learning-links"><view bindtap="homework"><view class="entry-title">作业</view><view class="subtle">查看与提交 ›</view></view><view bindtap="leave"><view class="entry-title">请假</view><view class="subtle">申请与进度 ›</view></view></view><view class="section-heading">考勤记录</view></block>
    <block wx:for="{{records}}" wx:key="recordKey">
      <view class="course-card" wx:if="{{recordKind==='enrollments'}}"><view class="card-heading"><text>{{item.courseClassName || '课程报名'}}</text><text class="status-pill {{item.actionable?'attention':''}}">{{section==='fees'?item.progressText:item.statusText}}</text></view><view class="subtle">{{item.subjectName}}<text wx:if="{{item.teacherName}}"> · {{item.teacherName}}</text></view><view class="course-time">{{item.timeText}}</view><view class="subtle" wx:if="{{section==='courses'}}">付款进度：{{item.progressText}}</view><block wx:if="{{section==='fees'}}"><view class="fee-primary" wx:if="{{item.settlementMethod!=='P'}}">应收 <text>{{item.payableAmount==null?(item.billingStatus==='HISTORY_PENDING'?'待核验':'待核价'):'¥'+item.amountText}}</text></view><view class="subtle" wx:if="{{item.settlementMethod!=='P'}}">实收 {{item.receivedLabel}} · 已退 {{item.refundedLabel}}</view><view class="subtle" wx:else>按课包额度结算</view></block><button class="text-button" wx:if="{{item.settlementMethod!=='P'}}" data-id="{{item.enrollmentId}}" bindtap="openFinance">{{item.actionable?'处理缴费':'缴费、收据与退款详情'}} ›</button></view>
      <view class="course-card" wx:elif="{{recordKind==='attendance'}}"><view class="card-heading">{{item.courseClassName}}<text class="status-pill">{{item.statusText}}</text></view><view class="course-time">{{item.timeText}}</view><view class="subtle">{{item.reviewText}}</view></view>
      <view class="course-card" wx:else><view class="card-heading">{{item.label}}<text class="status-pill">{{item.balance}}</text></view><view>{{item.title}}</view><view class="subtle">{{item.reason}}</view><view class="subtle">{{item.modifiedTime || item.createTime}} · {{item.actorName || '系统'}}</view></view>
    </block>
    <view class="basic-info"><view class="section-heading">基本资料</view><view class="subtle">{{child.studentName}} · {{child.gradeName}}<text wx:if="{{child.contactPhone}}"> · {{child.contactPhone}}</text></view><view class="text-link" bindtap="editProfile">编辑资料 ›</view></view>
  </block>
  <view class="empty-status" wx:if="{{loading}}">加载中…</view><view class="empty-status" wx:elif="{{!error && (view==='detail' || legacy) && !records.length}}">暂无{{recordKind==='attendance'?'考勤':recordKind==='history'?'流水':'课程'}}记录</view>
  <view class="child-pager" wx:if="{{total>30}}"><button size="mini" bindtap="previousPage" disabled="{{loading || pageNum===1}}">上一页</button><text>{{pageNum}} · 共 {{total}} 条</text><button size="mini" bindtap="nextPage" disabled="{{loading || pageNum*30>=total}}">下一页</button></view>
  <template is="personal-account-overlays" data="{{administrator,submitting,showForm,formKind,form,parentId,parentKeyword,parentOptions,parentIndex,grades,gradeIndex,account,showLink,showHistory,historyTitle,history,linkEnrollment,childOptions,childIndex,linkReason}}" />
</view>
</template>
