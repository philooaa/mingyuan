<template name="personal-account">
<view class="page">
  <view class="heading"><view class="title">{{administrator ? '交易管理' : '我的账户'}}<text class="inline-badge" wx:if="{{pendingBadge}}">{{pendingBadge}}</text></view><view class="muted">{{administrator ? '按家长归集孩子课包、付款与交易' : '孩子课包、课程付款与商城交易'}}</view></view>
  <block wx:if="{{administrator && !parentId}}">
    <view class="search"><input value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" placeholder="家长 / 孩子 / 联系电话"/><button size="mini" bindtap="search">查询</button></view>
    <button class="primary" bindtap="openCreate" disabled="{{submitting || loading}}">添加孩子信息</button>
    <view class="card parent-card" wx:for="{{personalAccounts}}" wx:key="parentId" data-id="{{item.parentId}}" bindtap="openPersonal"><view class="card-title">{{item.parentName}}<text class="inline-badge" wx:if="{{item.pendingBadge}}">{{item.pendingBadge}}</text><text class="chevron">›</text></view><view class="muted">{{item.parentPhone || '未留电话'}} · {{item.childCount}} 位孩子 · 家长 #{{item.parentId}}</view><view class="muted" wx:if="{{item.pendingCount}}">{{item.pendingCount}} 笔课程付款待登记</view></view>
    <view class="status" wx:if="{{!loading && !error && !personalAccounts.length}}">未找到家长账户</view>
  </block>
  <block wx:else>
    <view class="back" wx:if="{{administrator}}" bindtap="backAccounts">‹ 返回家长账户</view>
    <view class="card parent-summary" wx:if="{{detail}}"><view class="card-title">{{detail.parent.parentName}}</view><view class="muted">{{detail.parent.parentPhone || '未留电话'}} · {{accounts.length}} 位孩子</view><view class="pending-shortcut" bindtap="togglePending">待登记课程付款 {{pendingCount}} 笔　›</view></view>
    <view class="tabs"><view class="tab {{tab === 'children' ? 'active' : ''}}" data-tab="children" bindtap="switchTab">孩子课包</view><view class="tab {{tab === 'enrollments' ? 'active' : ''}}" data-tab="enrollments" bindtap="switchTab">课程付款<text class="tab-badge" wx:if="{{pendingBadge}}">{{pendingBadge}}</text></view><view class="tab {{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="switchTab">商城交易</view><view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">操作记录</view></view>
    <block wx:if="{{tab === 'children'}}">
      <button class="primary" bindtap="openCreate" disabled="{{submitting || loading || !detail}}">添加孩子信息</button>
      <view class="muted note">添加孩子信息后会建立零余额课次账户，报名与这里共用资料。旧报名姓名保留历史；有课次或交易记录的孩子不可删除。</view>
      <view class="card" wx:for="{{accounts}}" wx:key="accountId"><view class="card-title">{{item.studentName}}<text class="balance">{{item.availableCredits}}<text> 可用课次</text></text></view><view class="muted">{{item.gradeName}} · 孩子 #{{item.accountId}} · {{item.contactPhone || '未留电话'}}</view><view class="numbers">剩余 {{item.remainingCredits}}　暂占 {{item.reservedCredits}}　已消耗 {{item.consumedCredits}}</view><view class="actions"><button size="mini" data-id="{{item.accountId}}" bindtap="openEdit" disabled="{{submitting}}">修改资料</button><button size="mini" data-id="{{item.accountId}}" bindtap="removeChild" disabled="{{submitting}}">删除</button><button size="mini" data-id="{{item.accountId}}" bindtap="accountHistory">课次记录</button></view><view class="actions" wx:if="{{administrator}}"><button size="mini" data-id="{{item.accountId}}" data-action="GRANT" bindtap="openAdjust" disabled="{{submitting}}">发放课次</button><button size="mini" data-id="{{item.accountId}}" data-action="WITHDRAW" bindtap="openAdjust" disabled="{{submitting}}">收回课次</button></view></view>
      <view class="status" wx:if="{{!loading && !error && !accounts.length}}">暂无孩子资料，可在这里添加或报名时填写</view>
    </block>
    <block wx:elif="{{tab === 'enrollments'}}">
      <view class="filter-link" bindtap="togglePending">{{pendingOnly ? '✓ 仅看待登记付款 · 点击查看全部' : '仅看待登记付款'}}</view>
      <view class="muted note" wx:if="{{detail.unlinkedCount}}">{{detail.unlinkedCount}} 条旧报名尚未关联孩子，{{administrator ? '请核对后关联，不能按姓名自动合并。' : '请联系管理员核对关联。'}}</view>
      <view class="card" wx:for="{{records}}" wx:key="recordKey"><view class="card-title">{{item.studentName}}<text class="payment">{{item.settlementMethod === 'P' ? '课包结算' : item.paymentText}}</text></view><view>{{item.courseClassName || '课程报名'}}</view><view class="muted">{{item.classDate || '班课'}} · {{item.statusText}}</view><view class="muted">{{item.lessonAccountId ? '关联孩子：' + item.childName + ' #' + item.lessonAccountId : '旧记录 · 孩子待关联'}}</view><view class="muted">{{item.settlementMethod === 'P' ? '按课次额度结算，不计为本次现金付款' : (item.payableAmount == null ? '待核价／历史核验' : '应收 ¥' + item.payableAmount + ' · 实收 ¥' + item.receivedAmount + ' · 已退 ¥' + item.refundedAmount)}} · {{item.modifiedTime || item.createTime || '时间未提供'}}</view><view class="actions"><button size="mini" wx:if="{{item.settlementMethod !== 'P'}}" data-id="{{item.enrollmentId}}" bindtap="openFinance">{{administrator ? '收费与退款' : '缴费详情'}}</button><button size="mini" wx:if="{{administrator && !item.lessonAccountId}}" data-id="{{item.enrollmentId}}" bindtap="openLink" disabled="{{submitting}}">核对孩子</button></view></view>
    </block>
    <block wx:elif="{{tab === 'orders'}}"><view class="muted note">商城原订单与退款记录；金额按原记录展示，不参与课程待办计数。</view><view class="card" wx:for="{{records}}" wx:key="recordKey"><view class="card-title">{{item.title || '商城订单'}}<text class="payment">{{item.paymentText}}</text></view><view class="muted">{{item.orderCode}} · {{item.statusText}}</view><view class="numbers">应付 ¥{{item.payableAmount}}　实付 {{item.paidAmount == null ? '未付款' : '¥' + item.paidAmount}}　已退 ¥{{item.refundedAmount}}</view><view class="muted">{{item.modifiedTime || item.createTime}}</view></view></block>
    <block wx:else><view class="muted note">按业务修改时间倒序展示；额度变化与现金登记分别记录。</view><view class="card" wx:for="{{records}}" wx:key="recordKey"><view class="card-title">{{item.label}}<text class="payment">{{item.balance}}</text></view><view>{{item.title}}</view><view class="muted" wx:if="{{item.state}}">{{item.state}}</view><view class="muted">{{item.modifiedTime || item.createTime}} · {{item.actorName || '系统'}}</view><view class="muted">{{item.reason}}</view></view></block>
    <view class="status" wx:if="{{tab !== 'children' && !loading && !error && !records.length}}">暂无记录</view>
  </block>
  <view class="status" wx:if="{{loading}}">加载中…</view><view class="status" wx:if="{{error}}">{{error}}<button size="mini" bindtap="load">重试</button></view>
  <view class="actions pager" wx:if="{{(administrator && !parentId) || tab !== 'children'}}"><button size="mini" bindtap="previousPage" disabled="{{loading || pageNum === 1}}">上一页</button><text>{{pageNum}} · 共{{total}}条</text><button size="mini" bindtap="nextPage" disabled="{{loading || pageNum * 30 >= total}}">下一页</button></view>
  <template is="personal-account-overlays" data="{{administrator,submitting,showForm,formKind,form,parentId,parentKeyword,parentOptions,parentIndex,grades,gradeIndex,account,showLink,showHistory,historyTitle,history,linkEnrollment,childOptions,childIndex,linkReason}}" />
</view>
</template>

<template name="personal-account-overlays">
  <view class="mask" wx:if="{{showForm || showHistory || showLink}}"></view>
  <view class="sheet" wx:if="{{showForm}}"><view class="card-title">{{formKind === 'adjust' ? (form.action === 'GRANT' ? '发放课次' : '收回课次') : (formKind === 'edit' ? '修改孩子资料' : '添加孩子信息')}}</view>
    <block wx:if="{{formKind !== 'adjust'}}"><block wx:if="{{administrator && !parentId && formKind === 'create'}}"><view class="search"><input value="{{parentKeyword}}" bindinput="parentKeyword" placeholder="查找家长姓名 / 电话"/><button size="mini" bindtap="findParents">查找</button></view><picker class="field" range="{{parentOptions}}" value="{{parentIndex}}" bindchange="chooseParent" disabled="{{submitting}}"><view>家长：{{parentOptions[parentIndex] || '请选择家长'}}　›</view></picker></block><input class="field" maxlength="30" value="{{form.studentName}}" data-field="studentName" bindinput="input" placeholder="孩子姓名" disabled="{{submitting}}"/><picker class="field" range="{{grades}}" value="{{gradeIndex}}" bindchange="chooseGrade" disabled="{{submitting}}"><view>年级：{{grades[gradeIndex] || '请选择'}}　›</view></picker><input class="field" maxlength="11" type="number" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="input" placeholder="联系电话（选填）" disabled="{{submitting}}"/></block>
    <block wx:else><view class="muted">{{account.studentName}} · 可用{{account.availableCredits}}次</view><input class="field" type="number" value="{{form.quantity}}" data-field="quantity" bindinput="input" placeholder="课次数量（正整数）" disabled="{{submitting}}"/><textarea class="field" maxlength="255" value="{{form.reason}}" data-field="reason" bindinput="input" placeholder="操作原因（必填）" disabled="{{submitting}}"/></block><button class="delete-child" wx:if="{{!administrator && formKind==='edit'}}" data-id="{{account.accountId}}" bindtap="removeChild" disabled="{{submitting}}">删除孩子资料</button><view class="actions"><button bindtap="closeForm" disabled="{{submitting}}">取消</button><button class="primary" bindtap="save" loading="{{submitting}}" disabled="{{submitting}}">确认</button></view>
  </view>
  <view class="sheet" wx:if="{{showLink}}"><view class="card-title">核对旧报名的孩子归属</view><view>{{linkEnrollment.studentName}} · {{linkEnrollment.courseClassName}}</view><picker class="field" range="{{childOptions}}" value="{{childIndex}}" bindchange="chooseChild" disabled="{{submitting}}"><view>{{childOptions[childIndex] || '请先在孩子课包页添加孩子信息'}}　›</view></picker><textarea class="field" value="{{linkReason}}" bindinput="inputLinkReason" maxlength="255" placeholder="核对说明（必填）" disabled="{{submitting}}"/><view class="actions"><button bindtap="closeLink" disabled="{{submitting}}">取消</button><button class="primary" bindtap="saveLink" loading="{{submitting}}" disabled="{{submitting}}">确认关联</button></view></view>
  <view class="sheet" wx:if="{{showHistory}}"><view class="card-title">{{historyTitle}}</view><scroll-view scroll-y class="history"><view class="history-row" wx:for="{{history}}" wx:key="index"><view>{{item.label}}</view><view class="muted">{{item.balance}}</view><view class="muted">{{item.createTime}} · {{item.actorName}}</view><view class="muted">{{item.reason}}</view></view><view class="muted" wx:if="{{!history.length}}">暂无操作记录</view></scroll-view><button bindtap="closeHistory">关闭</button></view>
</template>
