<template name="classLeave">
  <view class="page">
    <view class="heading">{{teacher ? '班课请假审核' : '班课请假申请'}}</view>
    <view class="muted">{{teacher ? '仅显示本人授课班级的申请' : '仅开课前可申请；通过后请联系授课老师处理'}}</view>
    <button wx:if="{{!teacher}}" class="primary" bindtap="openForm" disabled="{{loading || submitting}}">申请请假</button>
    <view wx:if="{{showForm}}" class="card form">
      <picker range="{{children}}" range-key="label" value="{{childIndex}}" disabled="{{loading || submitting}}" bindchange="chooseChild"><view class="field">{{childIndex >= 0 ? children[childIndex].label : '选择孩子'}}<text>▾</text></view></picker>
      <picker range="{{courses}}" range-key="label" value="{{courseIndex}}" disabled="{{loading || submitting || !courses.length}}" bindchange="chooseCourse"><view class="field">{{courseIndex >= 0 ? courses[courseIndex].label : '选择已报名班课'}}<text>▾</text></view></picker>
      <picker range="{{lessons}}" range-key="label" value="{{lessonIndex}}" disabled="{{loading || submitting || lessonsLoading || !lessons.length}}" bindchange="chooseLesson"><view class="field">{{lessonIndex >= 0 ? lessons[lessonIndex].label : '选择具体课次'}}<text>▾</text></view></picker>
      <view class="muted" wx:if="{{!children.length}}">暂无有效班课报名。旧报名按原报名记录区分，不按姓名合并。</view>
      <view class="muted" wx:if="{{lessonsLoading}}">正在核对课次…</view>
      <view class="muted" wx:elif="{{courseIndex >= 0 && !lessons.length && !lessonError}}">没有可申请课次：可能未配置日期、已开课、停课，或已有申请／复核。</view>
      <view class="error" wx:if="{{lessonError}}">{{lessonError}}</view>
      <textarea maxlength="255" placeholder="填写请假原因（最多255字）" value="{{reason}}" disabled="{{submitting}}" bindinput="inputReason" />
      <view class="buttons"><button bindtap="closeForm" disabled="{{submitting}}">收起</button><button class="primary" bindtap="submit" disabled="{{loading || submitting || lessonsLoading}}" loading="{{submitting}}">提交申请</button></view>
    </view>
    <view class="tabs"><view class="{{state === '' ? 'active' : ''}}" data-state="" bindtap="filter">全部</view><view class="{{state === 'PENDING' ? 'active' : ''}}" data-state="PENDING" bindtap="filter">待审核<text class="pending-badge" wx:if="{{teacher && pendingBadge}}">{{pendingBadge}}</text></view><view class="{{state === 'APPROVED' ? 'active' : ''}}" data-state="APPROVED" bindtap="filter">已通过</view></view>
    <view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view>
    <view wx:for="{{rows}}" wx:key="leaveId" class="card">
      <view class="row"><text class="name">{{item.studentName}}</text><text class="state {{item.state}}">{{item.stateText}}</text></view>
      <view class="course">{{item.courseName}}</view><view class="time">{{item.timeText}}</view>
      <view class="muted">授课老师：{{item.teacherName || '待配置'}}</view>
      <view class="reason">请假原因：{{item.reason}}</view>
      <view class="reason" wx:if="{{item.reviewReason}}">审核意见：{{item.reviewReason}}</view>
      <view class="notice" wx:if="{{item.state === 'APPROVED'}}">已通过，请联系授课老师处理。</view>
      <view class="buttons"><button size="mini" data-id="{{item.leaveId}}" bindtap="showHistory" disabled="{{submitting}}">申请历史</button>
        <block wx:if="{{item.state === 'PENDING'}}"><button wx:if="{{teacher}}" size="mini" data-id="{{item.leaveId}}" data-action="REJECT" bindtap="act" disabled="{{loading || submitting}}">拒绝</button><button size="mini" class="primary" data-id="{{item.leaveId}}" data-action="{{teacher ? 'APPROVE' : 'WITHDRAW'}}" bindtap="act" disabled="{{loading || submitting}}">{{teacher ? '同意' : '撤回'}}</button></block>
      </view>
      <view class="history" wx:if="{{historyId === item.leaveId}}"><view wx:if="{{historyLoading}}">加载历史…</view><view wx:for="{{history}}" wx:for-item="event" wx:key="version"><view>{{event.label}} · {{event.timeText}}</view><view class="muted">{{event.reason}}</view></view></view>
    </view>
    <view class="empty" wx:if="{{loading}}">加载中…</view><view class="empty" wx:elif="{{!error && !rows.length}}">暂无请假申请</view>
    <view class="pagination" wx:if="{{total > 30}}"><button size="mini" bindtap="previous" disabled="{{loading || submitting || pageNum === 1}}">上一页</button><text>第 {{pageNum}} 页 · 共 {{total}} 条</text><button size="mini" bindtap="next" disabled="{{loading || submitting || pageNum * 30 >= total}}">下一页</button></view>
  </view>
</template>
