@import "education-ui.wxss";
.page{background:#f5f7fb;min-height:100vh;padding:24rpx;box-sizing:border-box}.heading{margin-bottom:24rpx}.title{font-size:36rpx;font-weight:700}.muted{font-size:24rpx;color:#768397;line-height:1.7}.tabs,.search,.actions{display:flex;align-items:center;gap:16rpx}.tabs{padding:8rpx;background:white;border-radius:14rpx;margin-bottom:20rpx}.tab{flex:1;padding:18rpx;text-align:center;font-size:27rpx;color:#768397}.active{background:#edf2ff;color:#2459d9;border-radius:10rpx}.search{background:white;border-radius:12rpx;padding:14rpx;margin-bottom:20rpx}.search input{flex:1;min-width:0;font-size:26rpx}.search button,.actions button{margin:0;font-size:24rpx}.primary{background:#2459d9;color:white;font-size:27rpx;border-radius:12rpx}.note{margin:16rpx 0}.card{padding:24rpx;background:white;border-radius:16rpx;margin-bottom:18rpx;border:1rpx solid #e8edf4;line-height:1.6;font-size:27rpx}.card-title{font-size:30rpx;font-weight:700;margin-bottom:12rpx}.balance{float:right;color:#2459d9;font-size:36rpx}.balance text{font-size:21rpx;font-weight:400}.payment{float:right;font-size:24rpx;color:#2459d9}.numbers{font-size:24rpx;margin:18rpx 0;background:#f5f7fb;padding:12rpx;border-radius:8rpx}.status{text-align:center;color:#768397;padding:28rpx}.pager{justify-content:space-between;font-size:24rpx;margin:24rpx 0}.mask{position:fixed;inset:0;background:rgba(20,30,45,.35);z-index:20}.sheet{position:fixed;bottom:0;left:0;right:0;z-index:21;background:white;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0;max-height:85vh;overflow:auto}.field{display:block;border-bottom:1rpx solid #edf0f4;padding:22rpx 0;font-size:27rpx;box-sizing:content-box}.sheet textarea{height:120rpx;width:100%}.sheet .actions{margin-top:26rpx}.sheet .actions button{flex:1;font-size:28rpx}.history{max-height:60vh}.history-row{padding:20rpx 0;border-bottom:1rpx solid #edf0f4}

.inline-badge,.tab-badge{display:inline-block;vertical-align:top;background:#e34d59;color:white;border-radius:24rpx;padding:0 10rpx;min-width:18rpx;line-height:32rpx;font-size:21rpx;text-align:center;margin-left:12rpx;font-weight:500}.tab{position:relative;font-size:24rpx;padding:20rpx 6rpx}.tab-badge{position:absolute;top:0;right:0;line-height:28rpx;font-size:19rpx}.chevron{float:right;color:#a4afbe}.back{color:#315ba0;margin:20rpx 0}.parent-card{position:relative;margin-top:18rpx}.pending-shortcut,.filter-link{font-size:25rpx;color:#315ba0;margin-top:16rpx}.actions{flex-wrap:wrap}.actions+.actions{margin-top:14rpx}.numbers{line-height:1.8}.sheet{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}
