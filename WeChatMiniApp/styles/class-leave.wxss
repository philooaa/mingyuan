page{background:#f4f7fb;color:#26364c}.page{padding:28rpx}.heading{font-size:38rpx;font-weight:700;margin-bottom:12rpx}.muted{font-size:25rpx;color:#78869a;line-height:1.6}.card{background:#fff;border-radius:20rpx;padding:26rpx;margin:22rpx 0}.row,.buttons,.tabs,.pagination{display:flex;align-items:center;gap:16rpx}.row{justify-content:space-between}.name{font-size:32rpx;font-weight:700}.course{font-size:29rpx;font-weight:600;margin:15rpx 0 8rpx}.time{font-size:28rpx;color:#315ba5;margin-bottom:8rpx}.reason{font-size:27rpx;line-height:1.6;margin-top:16rpx;white-space:pre-wrap;word-break:break-all}.state{font-size:23rpx;border-radius:8rpx;background:#eef2f7;padding:6rpx 12rpx;color:#718097}.PENDING{background:#fff5de;color:#9b741c}.APPROVED{background:#eaf6f0;color:#398667}.REJECTED{background:#fff0ef;color:#b76057}.notice{background:#f0f6fc;padding:16rpx;border-radius:10rpx;color:#4a6a90;font-size:26rpx;margin-top:16rpx}.buttons{justify-content:flex-end;margin-top:20rpx}.buttons button{margin:0;font-size:26rpx}.primary{background:#315ba5;color:white}.page>button{margin:24rpx 0}.tabs{margin:28rpx 0 10rpx;border-bottom:1rpx solid #e2e8f0}.tabs view{padding:16rpx;font-size:28rpx;color:#8190a4}.tabs .active{color:#315ba5;border-bottom:4rpx solid #315ba5;font-weight:600}.field{padding:22rpx 0;border-bottom:1rpx solid #edf0f4;font-size:28rpx;display:flex;justify-content:space-between;gap:15rpx}.field text{color:#96a0b0}.form textarea{margin-top:24rpx;padding:16rpx;box-sizing:border-box;width:100%;height:180rpx;background:#f7f9fc;border-radius:10rpx;font-size:28rpx}.empty,.error{text-align:center;padding:35rpx;color:#8895a8;font-size:27rpx}.error{color:#b05e51}.history{border-top:1rpx solid #edf0f4;margin-top:22rpx;padding-top:18rpx;font-size:25rpx;line-height:1.8}.history>view{padding-bottom:15rpx}.pagination{justify-content:space-between;font-size:24rpx}.pagination button{margin:0}

