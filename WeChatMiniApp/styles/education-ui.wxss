/* 教育业务页面共用视觉语言；页面字段和业务校验仍由原实现维护。 */
page { background:#f5f7fa; color:#202b3d; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif; }
button::after { border:0; }
button[disabled] { opacity:.45; }
.ui-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:28rpx 28rpx 20rpx; }
.ui-heading-main { flex:1; min-width:0; }
.ui-title { color:#202b3d; font-size:38rpx; font-weight:700; line-height:1.4; }
.ui-caption { margin-top:6rpx; font-size:24rpx; line-height:1.6; color:#68778c; }
.ui-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.ui-row > view:first-child { min-width:0; }
.ui-section-title { margin:28rpx 0 16rpx; font-size:28rpx; font-weight:700; color:#202b3d; }
.ui-time { margin:12rpx 0 6rpx; color:#2459d9; font-size:30rpx; font-weight:700; line-height:1.45; font-variant-numeric:tabular-nums; }
.ui-subtle { color:#68778c; font-size:24rpx; line-height:1.7; word-break:break-word; }
.ui-pill { display:inline-block; flex-shrink:0; padding:5rpx 14rpx; border-radius:8rpx; font-size:22rpx; font-weight:500; background:#edf2fc; color:#2459d9; line-height:1.5; }
.ui-pill-warning { background:#fff4dc; color:#8c5c05; }
.ui-pill-muted { background:#f0f2f5; color:#68778c; }
.ui-kv { display:flex; align-items:baseline; justify-content:space-between; gap:24rpx; padding:13rpx 0; border-bottom:1rpx solid #f0f2f5; font-size:26rpx; line-height:1.6; }
.ui-kv > text:first-child { color:#68778c; flex-shrink:0; }
.ui-kv > text:last-child { text-align:right; word-break:break-all; }
.ui-card-title { font-size:30rpx; color:#202b3d; font-weight:700; line-height:1.5; word-break:break-word; }
.ui-metrics { display:flex; gap:12rpx; margin:18rpx 0; }
.ui-metric { flex:1; text-align:center; padding:18rpx 4rpx; border-radius:12rpx; background:#f5f7fb; font-size:22rpx; color:#68778c; }
.ui-metric > view:first-child { font-size:34rpx; color:#202b3d; font-weight:700; margin-bottom:6rpx; }
.ui-primary { background:#2459d9; color:white; }
.ui-danger { background:#fff1f0; color:#bb3c3c; }
.ui-link { color:#2459d9; font-size:25rpx; }
.ui-tip { padding:16rpx 20rpx; border-radius:12rpx; background:#fff6e4; color:#8c5c05; font-size:24rpx; line-height:1.6; }
