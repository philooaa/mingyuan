/* 共用周课表的工具栏、图例与网格外观，基础定位来自 timetable.wxss。 */
.teacher-calendar { margin:0 24rpx; }
.week-toolbar { gap:6rpx; margin-top:12rpx; background:white; border:1rpx solid #e8edf4; border-radius:12rpx; padding:8rpx; }
.week-toolbar .week-arrow { flex-shrink:0; padding:0; width:54rpx; min-width:54rpx; height:62rpx; line-height:56rpx; font-size:42rpx; color:#52627a; background:transparent; }
.week-date { flex:1; min-width:0; }
.week-label { display:flex; align-items:center; justify-content:center; gap:6rpx; margin:0; font-size:26rpx; color:#202b3d; line-height:62rpx; font-weight:600; white-space:nowrap; }
.week-label text { margin-left:0; flex-shrink:0; color:#68778c; font-size:22rpx; }
.week-toolbar .week-today { padding:0 12rpx; height:54rpx; line-height:54rpx; background:#edf2ff; font-size:23rpx; color:#2459d9; flex-shrink:0; }
.calendar-note { color:#68778c; font-size:23rpx; margin:12rpx 0; line-height:1.6; }
.calendar-warning { padding:14rpx 18rpx; font-size:24rpx; background:#fff6e4; color:#8c5c05; border-radius:10rpx; line-height:1.6; }
.legend-scroll { width:100%; white-space:nowrap; margin:12rpx 0; }
.calendar-legend { display:inline-flex; flex-wrap:nowrap; gap:18rpx; margin:0; padding:4rpx 0; font-size:22rpx; color:#68778c; }
.calendar-legend > view { display:flex; align-items:center; flex-shrink:0; white-space:nowrap; }
.legend-dot { display:inline-block; width:14rpx; height:14rpx; border-radius:3rpx; margin-right:6rpx; }
.calendar-legend .gray { background:#8c939e; }.calendar-legend .yellow { background:#cc9400; }.calendar-legend .blue { background:#367ccd; }
.calendar-legend .orange { background:#dd801c; }.calendar-legend .green { background:#249477; }.calendar-legend .purple { background:#8251bd; }
.week-horizontal { border:1rpx solid #e3e9f2; border-radius:14rpx; }
.fixed-time-column,.time-axis { width:84rpx; }
.day-scroll { width:calc(100% - 84rpx); }
.fixed-time-column { background:#f9fafc; }
.calendar-top-anchor { height:0; width:1px; }
.time-head { background:#f0f3f8; font-size:23rpx; color:#68778c; }
.day-header-row { background:#f0f3f8; font-size:24rpx; color:#52627a; }
.day-head.today { background:#edf2ff; color:#2459d9; }
.hour-label { display:flex; flex-direction:column; justify-content:center; box-sizing:border-box; padding:6rpx 0; color:#68778c; font-size:22rpx; line-height:28rpx; }
.slot-start { color:#52627a; font-size:22rpx; font-weight:600; }
.slot-divider { color:#b6bec9; font-size:18rpx; line-height:20rpx; }
.slot-end { color:#68778c; font-size:22rpx; }
.slot-break { position:absolute; width:100%; background:#f2f4f7; pointer-events:none; }
.day-head,.day-column { border-left-color:#e8edf4; }
.lesson-block { padding:10rpx; border-radius:10rpx; font-size:22rpx; line-height:28rpx; }
.block-time { font-size:24rpx; line-height:30rpx; white-space:nowrap; }
.block-name { font-size:23rpx; line-height:30rpx; margin:6rpx 0; font-weight:700; }
.block-place { font-size:22rpx; line-height:28rpx; opacity:.9; }
.block-status { margin-top:6rpx; font-size:22rpx; line-height:28rpx; font-weight:600; }
.block-name,.block-place,.block-status { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
