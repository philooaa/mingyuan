@import "education-ui.wxss";
.page{padding:28rpx 24rpx 60rpx}.heading{font-size:38rpx;font-weight:700;margin-bottom:24rpx}.card{background:#fff;border:1rpx solid #e8edf4;border-radius:16rpx;padding:24rpx;margin-bottom:18rpx;line-height:1.8}.title{font-weight:600;font-size:29rpx;margin-bottom:12rpx}.muted{color:#68778c;font-size:24rpx;line-height:1.8}.code{font-size:36rpx;letter-spacing:4rpx;color:#2459d9;font-weight:700;margin:20rpx 0;word-break:break-all}.primary{background:#2459d9;color:#fff}.tabs{display:flex;background:#fff;border-radius:14rpx;margin:20rpx 0;padding:12rpx 0}.tabs>view{flex:1;text-align:center;position:relative;padding:14rpx 0;font-size:26rpx;color:#68778c}.tabs .active{color:#2459d9;font-weight:600}.badge{position:absolute;top:0;right:0;background:#df4545;color:#fff;border-radius:99rpx;padding:0 8rpx;font-size:20rpx;line-height:30rpx;min-width:24rpx}.row,.buttons,.filters{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.buttons{margin-top:18rpx;flex-wrap:wrap}.buttons button{margin:0;flex:1;font-size:24rpx}.filters{flex-wrap:wrap}.filters input{flex:1;min-width:240rpx}.filters picker{font-size:24rpx}.pill{font-size:22rpx;background:#edf2fc;color:#2459d9;border-radius:8rpx;padding:2rpx 10rpx;white-space:nowrap}input,.field,textarea{background:#f5f7fa;border:1rpx solid #e8edf4;border-radius:10rpx;padding:18rpx;margin:16rpx 0;font-size:26rpx}input{height:80rpx;padding:0 18rpx;line-height:normal;box-sizing:border-box}textarea{width:calc(100% - 36rpx);height:120rpx}.error{color:#a64538;font-size:25rpx;line-height:1.7;padding:16rpx 0}.empty{text-align:center;color:#68778c;padding:50rpx 0}.shade{position:fixed;inset:0;background:#0006;display:flex;align-items:flex-end;z-index:100}.sheet{background:#fff;height:84vh;box-sizing:border-box;width:100%;padding:28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:24rpx 24rpx 0 0}.person{display:block;font-size:26rpx;line-height:2.2}.history{word-break:break-all;font-size:21rpx;margin-top:12rpx}
